<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<TrueText id="ref-181">True</TrueText>
<FalseText id="ref-182">False</FalseText>
<Text id="ref-183">Not(CLA_MIN_POS_DONE = True And CLA_MAX_POS_DONE = True ) And CLA_MAX_RIG_POS &#62; 0</Text>
</a5:BooleanExpression>
<a6:NumericExpression id="ref-13" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
