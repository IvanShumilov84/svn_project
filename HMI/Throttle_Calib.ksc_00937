<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-317">If(OPC_AUTOCAL_STATUS=True,RIG_MSG_01,If(CLA_MAX_RIG_POS=0,RIG_MSG_02,If(CLA_MIN_POS_DONE=False,RIG_MSG_03,If(CLA_MAX_POS_DONE=False,RIG_MSG_04,CLA_RIG_MESSAGE_NEXT1))))</Text>
