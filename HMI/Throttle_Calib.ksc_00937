<Description id="ref-185">Return to Idle Position On Trips</Description>
<ToolTip id="ref-186">Return to Idle Position On Overtemp, Overtorque and Overspeed</ToolTip>
<Text id="ref-187">If( CLA_ENGINE_PROTECTION_ON, CLA_ENGINE_PROTECTION_ANGLE, &#34;NOT ARMED&#34;)</Text>
<Units id="ref-188">°</Units>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-189">F2</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
