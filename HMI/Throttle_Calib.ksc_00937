<ToolTip href="#ref-150"/>
<TrueText id="ref-379">True</TrueText>
<FalseText id="ref-380">False</FalseText>
<Text id="ref-381">If((CLA_MAX_RIG_POS &#62; 70) And (CLA_LEVER_POS &#62; 30) And (CLA_LEVER_POS &#60; 250), True, False ) </Text>
</a5:BooleanExpression>
