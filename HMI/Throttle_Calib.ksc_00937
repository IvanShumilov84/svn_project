<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-320">If(CLA_COMPUTE_DONE=False,RIG_MSG_05,If(CLA_MIN_STOP_POS_DONE=False,RIG_MSG_06,CLA_RIG_MESSAGE_NEXT2))</Text>
