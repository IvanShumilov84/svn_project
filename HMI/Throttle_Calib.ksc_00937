<a6:NumericExpression id="ref-134" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-775">RIG_MSG_01</Name>
<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-776">&#34;PLEASE WAIT UNTIL CALIBRATION HAS BEEN DONE BEFORE DOING RIGGING&#34;</Text>
<Units href="#ref-150"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-777">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-135" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-778">RIG_MSG_02</Name>
<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-779">&#34;PLEASE SET FCU MINMUM AND MAXIMUM ANGLE&#34;</Text>
<Units href="#ref-150"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-780">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-136" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-781">RIG_MSG_03</Name>
<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-782">&#34;SET YOUR 0 POSITION ON FCU EVEN IF THE FCU POSITION IS ALREADY AT 0. USE DISENGAGED/ENGAED BUTTON&#34;</Text>
<Units href="#ref-150"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-783">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-137" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-784">RIG_MSG_04</Name>
<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-785">&#34;SET YOUR MAXIMUM POSITION ON FCU BY USING DISENGAGED/ENGAGED BUTTON&#34;</Text>
<Units href="#ref-150"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-786">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-138" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-787">RIG_MSG_05</Name>
<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-788">&#34;PLEASE PRESS COMPUTE BUTTON&#34;</Text>
<Units href="#ref-150"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-789">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-139" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-790">RIG_MSG_06</Name>
<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-791">&#34;SET MINIMUM STOP POSITION. (IF THROTTLE GOES LOWER TO THIS POSITION, SERVO MOTOR WILL STOP MOVING AT THIS POSITION)&#34;</Text>
<Units href="#ref-150"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-792">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-140" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-793">RIG_MSG_07</Name>
<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-794">&#34;FOR ENGINE F100 YOU HAVE TO SET THE ABINHIBIT STOP POSITION. (WHEN ABHINIBIT IS ACTIVATED ON HMO SCREEN, SERVO MOTOR WILL STOP TO THAT POSITION)&#34;</Text>
<Units href="#ref-150"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-795">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-141" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-796">RIG_MSG_08</Name>
<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-797">&#34;SET THE MAXIMUM STOP POSITION. (IF THROTTLE GOES HIGHER TO THIS POSITION, SERVO MOTOR WILL STOP MOVING AT THIS POSITION)&#34;</Text>
<Units href="#ref-150"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-798">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-142" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-799">RIG_MSG_09</Name>
<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-800">&#34;ERROR LIMIT HAS BEEN GENERATED DURING RIGGING PROCEDURE.  PLEASE CLOSE TEST ET REOPEN THE ENGINE SESSION&#34;</Text>
<Units href="#ref-150"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-801">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-143" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
