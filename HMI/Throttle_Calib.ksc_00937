<Description href="#ref-150"/>
<ToolTip href="#ref-150"/>
<Text id="ref-323">If(TM_UUT_Model = &#34;XXXX&#34; ,RIG_MSG_07,If(CLA_MAX_STOP_POS_DONE=False,RIG_MSG_08,If(CLA_IDLE_POS_DONE=False,RIG_MSG_11,CLA_RIG_MESSAGE_NEXT3)))</Text>
