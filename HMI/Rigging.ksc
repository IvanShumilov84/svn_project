<a4:Expression id="ref-33" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-181">RiggingMessage</Name>
<Description id="ref-182">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-183">If(Autocal_Status=False,RigMes01,If(User_Rig_Max_Rig_Pos=0,RigMes02,If(Galil_StoreMinAngleDone=False,RigMes03,If(Galil_StoreMaxAngleDone=False,RigMes04,RiggingMessage1))))</Text>
</a4:Expression>
<a4:Expression id="ref-34" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-184">RiggingMessage1</Name>
<Description id="ref-185">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-186">If(Galil_ComputeDone=False,RigMes05,If(Galil_StoreMinStopDone=False,RigMes06,If(TM_UUT_Model = &#34;F100 PW200&#34; And Galil_StoreABStopDone=False,RigMes07,If(Galil_StoreMaxStopDone=False,RigMes08,If(GALIL_ErrorLimit,RigMes09,If(Galil_DoneRigging=True,RigMes10,&#34;CLOSE WINDOW&#34;)))))</Text>
</a4:Expression>
<a4:Expression id="ref-35" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-187">RigMes01</Name>
<Description id="ref-188">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-189">&#34;PLEASE WAIT UNTIL CALIBRATION HAS BEEN DONE BEFORE DOING RIGGING&#34;</Text>
</a4:Expression>
<a4:Expression id="ref-36" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-190">RigMes02</Name>
<Description id="ref-191">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-192">&#34;PLEASE SET FCU MINMUM AND MAXIMUM ANGLE&#34;</Text>
</a4:Expression>
<a4:Expression id="ref-37" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-193">RigMes03</Name>
<Description id="ref-194">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-195">&#34;YOU HAVE TO SET YOUR 0 POSITION ON FCU EVEN IF THE FCU POSITION IS ALREADY AT 0.  USE DISENGAGED/ENGAGED BUTTON&#34;</Text>
</a4:Expression>
<a4:Expression id="ref-38" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-196">RigMes04</Name>
<Description id="ref-197">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-198">&#34;YOU HAVE TO SET YOUR MAXIMUM POSITION ON FCU BY USING DISENGAGED/ENGAGED BUTTON&#34;</Text>
</a4:Expression>
<a4:Expression id="ref-39" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-199">RigMes05</Name>
<Description id="ref-200">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-201">&#34;PLEASE PRESS COMPUTE BUTTON&#34;</Text>
</a4:Expression>
<a4:Expression id="ref-40" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-202">RigMes06</Name>
<Description id="ref-203">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-204">&#34;NOW YOU HAVE TO SET MINIMUM STOP POSITION. (IF THROTTLE GOES LOWER TO THIS POSITION, SERVO MOTOR WILL STOP MOVING AT THIS POSITION)&#34;</Text>
</a4:Expression>
<a4:Expression id="ref-41" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-205">RigMes07</Name>
<Description id="ref-206">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-207">&#34;FOR ENGINE F100 YOU HAVE TO SET THE ABINHIBIT STOP POSITION. (WHEN ABHINIBIT IS ACTIVATED ON HMO SCREEN, SERVO MOTOR WILL STOP TO THAT POSITION)&#34;</Text>
</a4:Expression>
<a4:Expression id="ref-42" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-208">RigMes08</Name>
<Description id="ref-209">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-210">&#34;NOW YOU HAVE TO SET THE MAXIMUM STOP POSITION. (IF THROTTLE GOES HIGHER TO THIS POSITION, SERVO MOTOR WILL STOP MOVING AT THIS POSITION)&#34;</Text>
</a4:Expression>
<a4:Expression id="ref-43" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-211">RigMes09</Name>
<Description id="ref-212">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-213">&#34;ERROR LIMIT HAS BEEN GENERATED DURING RIGGING PROCEDURE.  PLEASE CLOSE TEST ET REOPEN THE ENGINE SESSION&#34;</Text>
</a4:Expression>
<a4:Expression id="ref-44" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-214">RigMes10</Name>
<Description id="ref-215">PROCEDURE</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-216">&#34;THE RIGGING PROCEDURE HAS NOW BEEN COMPLETED&#34;</Text>
</a4:Expression>
<a6:BooleanItem id="ref-45" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Servers.OpcClient/KineticaRT.Servers.OpcClient%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-217">User_Rig_Compute_Demand</Name>
