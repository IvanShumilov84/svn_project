<a4:Expression id="ref-55" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-285">Warning</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-286">If(Galil_ComputeDone,&#34;WARNING! NOW SERVO MOTOR IS MOVING IF THROTTLE MOVING&#34;,If(User_Rig_Engage_Demand=True,&#34;WARNING! SERVO MOTOR IS MOVING (ACTIVED)&#34;,&#34;SERVO MOTOR IS DISABLED&#34;))</Text>
</a4:Expression>
