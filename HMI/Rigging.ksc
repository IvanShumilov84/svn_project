<a3:BooleanChannel id="ref-6" xmlns:a3="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Channels/KineticaRT%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-56">CLOSE_RIGGING_BUTTON</Name>
<Description id="ref-57">Close</Description>
<ToolTip id="ref-58"></ToolTip>
<TrueText id="ref-59">True</TrueText>
<FalseText id="ref-60">False</FalseText>
</a3:BooleanChannel>
<a4:Expression id="ref-7" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-61">EnableComputeButton</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-62">Galil_StoreMinAngleDone  And Galil_StoreMaxAngleDone And User_Rig_Engage_Demand = False And Galil_ComputeDone = False</Text>
</a4:Expression>
<a4:Expression id="ref-8" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-63">EnableEngageDemand</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-64">Not(Galil_StoreMinAngleDone = True And Galil_StoreMaxAngleDone = True ) And Autocal_Status = True And User_Rig_Max_Rig_Pos &#62; 0</Text>
</a4:Expression>
<a4:Expression id="ref-9" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-65">EnableStoreABStopButton</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-66">Galil_ComputeDone = True And Autocal_Status = True And TM_UUT_Model = &#34;F100 PW200&#34;  And Galil_StoreABStopDone = False And Galil_StoreMinStopDone = True</Text>
</a4:Expression>
<a4:Expression id="ref-10" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-67">EnableStoreMaxBtnATAR</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-68">If((User_Rig_Max_Rig_Pos = 90) And (LevPosRT &#62; 7.0) And (LevPosRT &#60; 7.3), True, False ) </Text>
</a4:Expression>
<a4:Expression id="ref-11" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-69">EnableStoreMaxBtnF100</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-70"> If((User_Rig_Max_Rig_Pos = 130) And (LevPosRT &#62; 8.1) And (LevPosRT &#60; 8.5), True, False ) </Text>
</a4:Expression>
<a4:Expression id="ref-12" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-71">EnableStoreMaxButton</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-72">Galil_StoreMinAngleDone And User_Rig_Max_Rig_Pos &#62; 80 And Galil_StoreMaxAngleDone = False And Galil_StoreMinAngleDone And User_Rig_Engage_Demand = False And Autocal_Status And (EnableStoreMaxBtnATAR Or EnableStoreMaxBtnF100)</Text>
</a4:Expression>
<a4:Expression id="ref-13" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-73">EnableStoreMaxStopButton</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-74">(EnableStoreMaxBtnF100 = True Or EnableStoreMaxBtnATAR = True) And Galil_ComputeDone And Galil_StoreMaxStopDone = False And Galil_StoreMinStopDone</Text>
</a4:Expression>
<a4:Expression id="ref-14" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-75">EnableStoreMinButton</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-76">Galil_StoreMinAngleDone = False And User_Rig_Min_Rig_Pos &#60; 1 And Galil_StoreMinAngleDone = False And Autocal_Status And User_Rig_Engage_Demand = False And ( If(User_Rig_Min_Rig_Pos = 0 And LevPosRT &#60; 4.7, True, False )  )  </Text>
</a4:Expression>
<a4:Expression id="ref-15" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-77">EnableStoreMinStopButton</Name>
<Description href="#ref-58"/>
<ToolTip href="#ref-58"/>
<Text id="ref-78">Galil_ComputeDone And Galil_StoreMinStopDone = False And ( If(User_Rig_Min_Rig_Pos = 0 And LevPosRT &#60; 4.7, True, False )  )  </Text>
</a4:Expression>
<a5:BooleanVariable id="ref-16" xmlns:a5="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Channels/KineticaRT.Logic.Channels%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
