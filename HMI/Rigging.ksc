</a6:BooleanItem>
<a4:Expression id="ref-26" xmlns:a4="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-136">LevPosDegreeRT</Name>
<Description id="ref-137">FCU PLA</Description>
<ToolTip href="#ref-58"/>
<Text id="ref-138">If(Compute_Done=True,(PosMotorCountRT * User_Rig_Max_Rig_Pos)/(MaxActuatorPosition - MinActuatorPosition) ,0)</Text>
</a4:Expression>
<a6:Item id="ref-27" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Servers.OpcClient/KineticaRT.Servers.OpcClient%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
