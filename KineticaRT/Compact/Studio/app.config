<?xml version="1.0" encoding="utf-8" ?> 
<configuration>
	<system.diagnostics>
		<switches>
			<add name="Studio" value="1" />
			<add name="KineticaRT.Channels" value="1" />
			<add name="KineticaRT.Servers.Logger" value="4" />
			<add name="KineticaRT.Servers.OpcClient" value="1" />
			<add name="KineticaRT.Servers.SmartDrive" value="1" />
			<add name="KineticaRT.Controls.Button" value="1" />
			<add name="KineticaRT.Studio.Controls.Button" value="1" />
		</switches>
	</system.diagnostics>
  <appSettings>
    <add key="ServerUrl" value="http://192.168.0.12/KineticaRT/service.asmx" />
    <add key="SystemName" value="PDA" />
  </appSettings>
</configuration>
