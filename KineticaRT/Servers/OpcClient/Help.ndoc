<project SchemaVersion="1.3">
    <assemblies>
        <assembly location=".\bin\Release\KineticaRT.dll" documentation=".\bin\Release\KineticaRT.xml" />
        <assembly location=".\bin\Release\KineticaRT.Servers.OpcClient.dll" documentation=".\bin\Release\KineticaRT.Servers.OpcClient.xml" />
    </assemblies>
    <documenters>
        <documenter name="Intellisense">
            <property name="OutputDirectory" value=".\intellisense\" />
        </documenter>
        <documenter name="JavaDoc">
            <property name="OutputDirectory" value=".\doc\" />
        </documenter>
        <documenter name="MSDN">
            <property name="OutputDirectory" value=".\doc\" />
            <property name="HtmlHelpName" value="KineticaRT.Servers.OpcClient" />
            <property name="Title" value="KineticaRT.Servers.OpcClient " />
            <property name="ShowVisualBasic" value="True" />
            <property name="OutputTarget" value="HtmlHelp" />
            <property name="RootPageFileName" value="Overview.htm" />
            <property name="AssemblyVersionInfo" value="AssemblyFileVersion" />
            <property name="CopyrightText" value="Copyright KineticaRT Ltd 2003.  All rights reserved." />
            <property name="CopyrightHref" value="http:\\www.kineticart.co.uk" />
        </documenter>
        <documenter name="XML">
            <property name="OutputFile" value=".\doc\doc.xml" />
        </documenter>
    </documenters>
</project>