<project SchemaVersion="1.3">
    <assemblies>
        <assembly location=".\bin\Release\KineticaRT.Servers.Power.dll" documentation=".\bin\Release\KineticaRT.Servers.Power.xml" />
        <assembly location=".\bin\Release\KineticaRT.dll" documentation=".\bin\Release\KineticaRT.xml" />
    </assemblies>
    <namespaces>
        <namespace name="KineticaRT">The KineticaRT namespace contains fundamental classes and base classes for use in the KineticaRT System. </namespace>
    </namespaces>
    <documenters>
        <documenter name="MSDN 2003">
            <property name="OutputDirectory" value=".\doc\" />
            <property name="HtmlHelpName" value="Vaisala Humicap Reference" />
            <property name="Title" value="Vaisala Humicap Reference" />
        </documenter>
        <documenter name="Intellisense">
            <property name="OutputDirectory" value=".\intellisense\" />
        </documenter>
        <documenter name="JavaDoc">
            <property name="OutputDirectory" value=".\doc\" />
        </documenter>
        <documenter name="MSDN">
            <property name="OutputDirectory" value=".\doc\" />
            <property name="HtmlHelpName" value="KineticaRT.Servers.Power Reference" />
            <property name="Title" value="KineticaRT.Servers.Power  Reference" />
            <property name="OutputTarget" value="HtmlHelp" />
            <property name="SdkLinksOnWeb" value="True" />
            <property name="RootPageContainsNamespaces" value="True" />
            <property name="AssemblyVersionInfo" value="AssemblyFileVersion" />
            <property name="CopyrightText" value="Copyright KineticaRT Ltd 2007" />
            <property name="UseNamespaceDocSummaries" value="True" />
            <property name="AutoPropertyBackerSummaries" value="True" />
            <property name="DocumentAttributes" value="True" />
            <property name="DocumentedAttributes" value="DefaultValue" />
            <property name="InstanceMembersDefaultToSafe" value="True" />
            <property name="CleanIntermediates" value="True" />
        </documenter>
        <documenter name="XML">
            <property name="OutputFile" value=".\doc\doc.xml" />
        </documenter>
    </documenters>
</project>