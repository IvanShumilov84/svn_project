<?xml version="1.0" encoding="utf-8"?>
<Test>
  <TestProfile Name="DryMotorProcedure">
    <Setpoints>
      <Setpoint Title="PLA"  Name="O_PLA" Type="Double"/>
      <Setpoint Title="SECEN" Name="O_SECEN" Type="Boolean"/>
    </Setpoints>
    <Step Name="0.1">
      <Setpoint Name="O_PLA" Value="0" />
      <Setpoint Name="O_SECEN" Value="false" />
      <Action Name="WaitForAcknowledge" Message="OK to start?" Information="Initialising Test: DryMotorProcedure" />
      <Set Name="PLAIDLTMR" Value="0" />
      <Set Name="I_SECEN" Value="0" />
      <Set Name="I_PLA" Value="14" />
    </Step>
    <Step Name="0.2">
      <Setpoint Name="O_PLA" Value="17" />
      <Setpoint Name="O_SECEN" Value="true" />
      <Set Name="UserInformationMessage" Expression="&quot;DryMotorProcedure: Wait for I_PLA = 16, currently = &quot;+I_PLA" />
      <Wait Name="I_PLA" Value="16" Timeout="6000" OnTimeout="0.1" />
      <Set Name="UserInformationMessage" Value="DryMotorProcedure: Wait for I_SECEN = 1" />
      <Wait Name="I_SECEN" Value="1" Timeout="6000" OnTimeout="1" />
      <Set Name="UserInformationMessage" Value="DryMotorProcedure: Wait for I_PLA = 16 And I_SECEN = 1" />
      <Wait Condition="I_PLA = 16 And I_SECEN = 1" />
      <Set Name="UserInformationMessage" Value="" />
      <Goto Name="0.1" />
    </Step>
    <Step Name="1">
      <Action Name="WaitForAcknowledge" Message="Perform MCD VLV Leak Check, Press Acknowledge when complete..." Information="DryMotorProcedure" />
    </Step>
    <Step Name="2">
      <Set Name="UserInformationMessage" Value="DryMotorProcedure: Wait for PLAIDLTMR = 300" />
      <Wait Name="PLAIDLTMR" Value="300" />
      <Set Name="UserInformationMessage" Value="" />
      <Action Name="Record S-S Data" />
      <Action Name="VerifyInputs" />
    </Step>
    <Step Name="3">
      <Setpoint Name="O_SECEN" Value="false" />
      <Action Name="ResetPLAIDLTMR" />
      <Action Name="WaitForAcknowledge" Message="Confirm SEC light on, Press Acknowledge when complete..." Information="DryMotorProcedure" />
    </Step>
    <Step Name="4">
      <Set Name="UserInformationMessage" Value="DryMotorProcedure: Wait for PLAIDLTMR = 30" />
      <Wait Name="PLAIDLTMR" Value="30" />
      <Set Name="UserInformationMessage" Value="" />
      <Action Name="Record S-S Data" />
      <Set Name="UserInformationMessage" Value="DryMotorProcedure: Performing SEC idle leak check." />
      <Stop />
    </Step>
    <Step Name="Shutdown">
      <Setpoint Name="O_PLA" Value="0" />
      <Setpoint Name="O_SECEN" Value="false" />
      <Set Name="UserInformationMessage" Value="DryMotorProcedure: Complete." />
    </Step>
  </TestProfile>
  <TestProfile>
  </TestProfile>
</Test>