    <namespaceSummaries>
        <namespaceSummaryItem name="" isDocumented="False" />
        <namespaceSummaryItem name="FroudeTexcelT100AVmeInterface" isDocumented="False" />
        <namespaceSummaryItem name="KineticaRT" isDocumented="True">Root namespace for KineticaRT.

This namespace contains the base classes from which all other KineticaRT components are derived.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Audio" isDocumented="True">This namespace contains classes for the transfer of Audio via the KineticaRTAudio web service including classes to provide a user interface for an intercom communication system.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Audio.KineticaRTAudio" isDocumented="False" />
        <namespaceSummaryItem name="KineticaRT.Audio.Properties" isDocumented="False" />
        <namespaceSummaryItem name="KineticaRT.Channels" isDocumented="True">This namespace contains the basic live data channel classes used by KineticaRT, additional classes may be based on these.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Controls" isDocumented="True">Namespace for user interface controls used by KineticaRT.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Controls.Aircraft" isDocumented="True">Contains specialised controls simulating real Aircraft displays.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Controls.Aircraft.Properties" isDocumented="False" />
        <namespaceSummaryItem name="KineticaRT.Controls.Compass" isDocumented="True">Contains classes for Compass (direction display) controls.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Logic.Channels" isDocumented="True">This namespace extends the KineticaRT.Channels namespace with classes that process the live data.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Logic.Expressions" isDocumented="True">Provides live expression processing, used mainly by the classes in the KineticaRT.Logic.Channels class.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Logic.Expressions.Design" isDocumented="False" />
        <namespaceSummaryItem name="KineticaRT.Logic.Filters" isDocumented="True">Provides classes to filter live data channels.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Logic.Message" isDocumented="True">This namespace contains classes to handle and process, display, read etc.  messages such as threshold and error messages.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Logic.Test" isDocumented="True">This namespace contains classes to implement sequencial testing controlled by test script files.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Logic.Timing" isDocumented="True">This namespace extends the KineticaRT.Channels namespace with classes for timing of events.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Sequence" isDocumented="True">This namespace allows for control sequences to be written and incorportated into the KineticaRT application using both the C# and Visual Basic languages.  It contains a compiler for compiling these sequences.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.BallardOmnibox" isDocumented="True">This namespace provides an interface to provide live data from and contol of Ballard Omnibox1553 avionics bus interface devices.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.Casella" isDocumented="True">This namespace provides an interface to provide live data from and contol of Casella Sensus weather station devices.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.Exchange" isDocumented="True">This namespace provides an interface to provide transfer of live data via a KineticaRT Exchange web service, both between applications on different computers and between applications on the same computer.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.Exchange.Exchange" isDocumented="False" />
        <namespaceSummaryItem name="KineticaRT.Servers.Exchange.Properties" isDocumented="True" />
        <namespaceSummaryItem name="KineticaRT.Servers.Froude" isDocumented="True">This namespace provides an interface to provide live data from Froude Texcel T100A dynamometer controller devices.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.Intercom" isDocumented="True">This namespace provides an interface to provide live data from and contol of Barix Annuncicom, Exstreamer and Instreamer intercom devices.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.Log" isDocumented="True">This namespace provides logging and playback of data to/from the filesystem.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.OpcClient" isDocumented="True">This namespace provides an interface to provide live data from OPC DA 2.0 servers.  

The OPC protocol provides for communication with a vast number of devices.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.OpcClient.Design" isDocumented="False" />
        <namespaceSummaryItem name="KineticaRT.Servers.Power" isDocumented="True">This namespace provides an interface to provide live data from Windows compatible uninteruptable power supply (UPS)  devices.  It also provides for shutdown of the application/computer.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.ScreenSaver" isDocumented="True">This namespace provides an imitation screen saver display which can be controlled from the KineticaRT application.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.Security" isDocumented="True">This namespace provides an interface to USB data key devices to allow their use as keys for a security/user identification system.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.Security.KineticaRTSafe" isDocumented="False" />
        <namespaceSummaryItem name="KineticaRT.Servers.Security.Properties" isDocumented="True" />
        <namespaceSummaryItem name="KineticaRT.Servers.Simulate" isDocumented="True">This namespace provides simulated live data for test purposes.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.TC65TModem" isDocumented="True">This namespace provides an interface to contol TC65T GPRS modem devices for sending of text messages and pre recorded audio messages.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.Vaisala.Humicap" isDocumented="True">This namespace provides an interface to provide live data from Vaisala Humicap humidity sensor devices.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Servers.Video" isDocumented="True">This namespace provides an interface to provide contol of Axis video server devices and Mic400 pan tilt zoom cameras, also contains video display components for the Axis video servers.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Studio" isDocumented="True">This namespace provides the KineticaRT Studio application in which KineticaRT live data channels and live data displays can be configured and  used.

KineticaRT live data channels and live data displays can also be used in other applications.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Studio.Application" isDocumented="True">This namespace provides control of the KineticaRT Studio application and allows for run time reconfiguration.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Studio.Controls" isDocumented="True">This namespace provides extended, more specialised controls based on the classes of the KineticaRT.Controls namespace.</namespaceSummaryItem>
        <namespaceSummaryItem name="KineticaRT.Studio.Properties" isDocumented="False" />
        <namespaceSummaryItem name="KineticaRT.Values" isDocumented="True">This namespace provides the Value classes used as live data values by the other KineticaRT components.</namespaceSummaryItem>
        <namespaceSummaryItem name="Sis3150usbVmeWin" isDocumented="False" />
        <namespaceSummaryItem name="StreamComputers.Riff" isDocumented="False" />
        <namespaceSummaryItem name="Test" isDocumented="False" />
    </namespaceSummaries>
