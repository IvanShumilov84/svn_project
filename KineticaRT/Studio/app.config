<?xml version="1.0"?>
<configuration>

  <configSections>
    <sectionGroup name="EntitySpaces" type="EntitySpaces.Interfaces.esConfigSettings, EntitySpaces.Core">
      <section name="connectionInfo" type="EntitySpaces.Interfaces.esConfigSettings, EntitySpaces.Interfaces" allowLocation="true" allowDefinition="Everywhere" restartOnExternalChanges="true"/>
    </sectionGroup>
    <sectionGroup name="White">
      <section name="Core" type="System.Configuration.NameValueSectionHandler"/>
    </sectionGroup>
    <section name="engineConfigurationSection" type="StudioDemonstration.EngineConfigurationSection, ConfigurationSettings, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null"/>
    <section name="reportConfigurationSection" type="StudioDemonstration.ReportConfigurationSection, ConfigurationSettings, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null"/>
    <section name="databaseConfigurationSection" type="StudioDemonstration.DatabaseConfigurationSection, ConfigurationSettings, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null"/>
    <section name="projectConfigurationSection" type="StudioDemonstration.ProjectConfigurationSection, ConfigurationSettings, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null"/>
    
  </configSections>
  <runtime>
    <!-- Cette ligne permet au PC Slave le loader et executer l<application en prenant comme source le PC MASTER -->
    <loadFromRemoteSources enabled="true"/>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Drawing" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Windows.Forms" publicKeyToken="b77a5c561934e089" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System" publicKeyToken="b77a5c561934e089" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Data" publicKeyToken="b77a5c561934e089" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <White>
    <Core>
      <add key="LogActions" value="false"/>
      <add key="WorkSessionLocation" value="."/>
      <add key="PopupTimeout" value="8000"/>
      <add key="MouseDelayForTooltip" value="0"/>
      <add key="SuggestionListTimeout" value="3000"/>
      <add key="BusyTimeout" value="5000"/>
      <add key="WaitBasedOnHouseGlass" value="true"/>
      <add key="UIAutomationZeroWindowBugTimeout" value="8000"/>
      <add key="TooltipWaitTime" value="3000"/>
    </Core>
  </White>
  <EntitySpaces>
    <connectionInfo default="ACCESSDynamic">
      <connections>
       <!-- <add name="SqlDevServer" providerMetadataKey="esDefault" sqlAccessType="DynamicSQL" provider="EntitySpaces.SqlClientProvider" providerClass="DataProvider" connectionString="User ID=sa; . . . " databaseVersion="2005" />-->
        <add name="ACCESSDynamic" providerMetadataKey="esDefault" sqlAccessType="DynamicSQL" provider="EntitySpaces.MSAccessProvider" providerClass="DataProvider" connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=C:\My Projects\CELDAS 200\Workbench\TestSession.mdb;Jet OLEDB:System database=C:\My Projects\CELDAS 200\Workbench\Secured.mdw;User Id=Administrator;Password=XXXXXX"/>
     
      </connections>
      <!--La connection string ici haut est override dans le opentest du DAS plus besoin de specifier le mot de passe-->
    </connectionInfo>
  </EntitySpaces>


  <engineConfigurationSection>
    <engineInformation engineModel="APS1000-C2" ductDiameter="1.000" ductDiameterUnit="Inch" orificeDiameter="4" orificeDiameterUnit="Inch" performanceReportTemplateFile="C:\My Projects\CELDAS 200\HMI\APS1000\APS1000-C2C3C7 Performance.xlsx"/>
    <engineInformation engineModel="APS1000-C3" ductDiameter="1.000" ductDiameterUnit="Inch" orificeDiameter="4" orificeDiameterUnit="Inch" performanceReportTemplateFile="C:\My Projects\CELDAS 200\HMI\APS1000\APS1000-C2C3C7 Performance.xlsx"/>
    <engineInformation engineModel="APS1000-C7" ductDiameter="1.000" ductDiameterUnit="Inch" orificeDiameter="4" orificeDiameterUnit="Inch" performanceReportTemplateFile="C:\My Projects\CELDAS 200\HMI\APS1000\APS1000-C2C3C7 Performance.xlsx"/>
    <engineInformation engineModel="APS1000-C12" ductDiameter="1.000" ductDiameterUnit="Inch" orificeDiameter="4" orificeDiameterUnit="Inch" performanceReportTemplateFile="C:\My Projects\CELDAS 200\HMI\APS1000\APS1000-C12 Performance.xlsx"/>
    <engineInformation engineModel="APS3200" ductDiameter="8.071" ductDiameterUnit="Inch" orificeDiameter="4" orificeDiameterUnit="Inch" performanceReportTemplateFile="C:\My Projects\CELDAS 200\HMI\APS3200\APS3200_PerformanceAirbusAcceptance.xlsx"/>
    <engineInformation engineModel="GTCP131-9A" ductDiameter="8.071" ductDiameterUnit="Inch" orificeDiameter="4" orificeDiameterUnit="Inch" performanceReportTemplateFile="C:\My Projects\CELDAS 200\HMI\GTCP131_9A\Revima_12917REVA_GTCP131_9A.xlsx"/>
    <engineInformation engineModel="GTCP131-9B" ductDiameter="8.071" ductDiameterUnit="Inch" orificeDiameter="4" orificeDiameterUnit="Inch" performanceReportTemplateFile="C:\My Projects\CELDAS 200\HMI\GTCP131_9B\China_11813REVA_GTCP131_9B.xlsx"/>
    <engineInformation engineModel="GTCP85-129" ductDiameter="8.071" ductDiameterUnit="Inch" orificeDiameter="4" orificeDiameterUnit="Inch" performanceReportTemplateFile="C:\My Projects\CELDAS 200\HMI\GTCP85_129\Garuda_10726REVA_GTCP85_129.xlsx"/>
    <engineInformation engineModel="TSCP700" ductDiameter="8" ductDiameterUnit="Inch" orificeDiameter="6" orificeDiameterUnit="Inch" performanceReportTemplateFile="C:\My Projects\CELDAS 200\HMI\TSCP700\Revima_12917REVA_TSCP700.xlsx"/>

  </engineConfigurationSection>


  <reportConfigurationSection>
    <reportInformation calibrationReportOutputDirectory="C:\                        Calibration Reports\" calibrationReportTemplateFile="C:\My Projects\CELDAS 200\Workbench\PrjExt\GMF_Report_Calibration.xlsx" checkReportOutputDirectory="C:\Check Reports\" checkReportTemplateFile="C:\My Projects\CELDAS 200\Workbench\PrjExt\GMF_Report_Check.xlsx" logReportTemplateFile="C:\My Projects\CELDAS 200\HMI\PrjExt\Log_report.xlsx"/>
  </reportConfigurationSection>

<!--
  <databaseConfigurationSection>
    <databaseInformation path="C:\My Projects\CELDAS 200\Workbench\"
			databaseFilename="TestSession.mdb" workGroupFilename="Secured.mdw"
			userId="Administrator"  />
  </databaseConfigurationSection>
  
-->
  <databaseConfigurationSection>
    <databaseInformation path="C:\My Projects\CELDAS 200\Workbench\" databaseFilename="TestSession.mdb" workGroupFilename="Secured.mdw" userId="Administrator"/>
  </databaseConfigurationSection>
  
  
  <projectConfigurationSection>
    <projectInformation name="CEL Master Project" number="11894"/>
  </projectConfigurationSection>
  
  
  
  <system.diagnostics>
    <switches>
      <add name="Studio" value="1"/>
      <add name="KineticaRT.Channels" value="1"/>
      <add name="KineticaRT.Servers.Logger" value="4"/>
      <add name="KineticaRT.Servers.OpcClient" value="1"/>
      <add name="KineticaRT.Servers.SmartDrive" value="1"/>
      <add name="KineticaRT.Controls.Button" value="1"/>
      <add name="KineticaRT.Studio.Controls.Button" value="1"/>
    </switches>
  </system.diagnostics>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2"/>
  </startup>
</configuration>
