    <namespaces>
        <namespace name="KineticaRT">The KineticaRT namespace contains fundamental classes and base classes for use in the KineticaRT System. </namespace>
        <namespace name="KineticaRT.Logic.Expressions">The KineticaRT.Logic.Expressions namespace contains objects for evaluating text based expressions involving KineticaRT channels.</namespace>
        <namespace name="KineticaRT.Logic.Filters">The KineticaRT.Logic.Filters namespace contains objects for filtering the values of KineticaRT channels in realtime.</namespace>
    </namespaces>
