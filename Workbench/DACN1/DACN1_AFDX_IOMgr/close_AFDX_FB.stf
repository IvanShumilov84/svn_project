FUNCTION_BLOCK close_AFDX_FB
(************************************************************************************************************************************************
	Name :		close_PowerDNA_FB									
														
	Description :	Close communication with powerdna box and rdata 							      

	Dependacy : 	
					HYSTORY

	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         2009/02/15		J.Hamelin	First Release
	
************************************************************************************************************************************************)	

err_code := OK;
status := CLOSING;
	
IF First_Time_Close = TRUE THEN

	err_code 	:= OK;
    dummy  := LOG_MSG('ErrLog', 'DACN1_AFDX_IOMGR: CLOSING');


	IF(In_AFDX_IOMgr.mode = RUN_FOR_TRUE)THEN

		IF PowerDNA_Structure.hAfdxDev <> 0 THEN
			PowerDNA_AfdxDestroy_Device(PowerDNA_Structure.hAfdxDev);
			PowerDNA_Structure.hAfdxDev := 0;
		END_IF;
		
		IF ((PowerDNA_Structure.handle <> -1) AND (PowerDNA_Structure.Status = RUN)) THEN
				
			POWERDNA_CLOSE(PowerDNA_Structure.handle);
 
			IF (POWERDNA_CLOSE.ERR_CODE <> 0) THEN

				err_code := POWERDNA_CLOSE.ERR_CODE ;

			END_IF;
 
			PowerDNA_Structure.handle := -1;

		END_IF;

		POWERDNA_CLEANUPLIB();

	END_IF; 
		


	IF err_code = OK THEN 

		wait_for_File_Closed(FALSE, t#8s);

		(*IF (rdata_base <> 0) THEN
	
			CLOSE_RDATA(rdata_base);

			err_code   := CLOSE_RDATA.ERR_CODE;
			rdata_base := 0;

		END_IF;*)

		Out_AFDX_IOMgr.previous_index := 0;

	END_IF; 

	First_Time_Close := FALSE;
	
END_IF;

wait_for_File_Closed(TRUE, t#8s);

IF (wait_for_File_Closed.Q = TRUE) AND (err_code = OK) THEN

	status 	:= CLOSED;
	dummy	:= LOG_MSG('ErrLog', 'DACN1_AFDX_IOMGR: CLOSED');


	PowerDNA_Structure.status := CLOSED;



ELSIF (wait_for_File_Closed.Q = TRUE) AND (err_code <> OK) THEN

	status	:= ERROR_ON_CLOSING;	
	dummy	:= LOG_MSG('ErrLog', 'DACN1_AFDX_IOMGR: ERROR_ON_CLOSING');

END_IF; 

			

























END_FUNCTION_BLOCK
