PROGRAM MAIN
(************************************************************************************************************************************************
	Name :		MAIN									
														
	Description :	 							      

	Dependacy : 	
					HYSTORY

	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         					First Release
	2.0	          2002/10/17		N. Sangiovanni	Calibration modification

************************************************************************************************************************************************)	
	IF (First_Time_Trough = TRUE) THEN 
		First_Time_Trough := FALSE;
		Out_AFDX_IOMgr.status := IDLING;
		(*ft count_Xfer := 0;*)
	END_IF; 

	CASE  In_AFDX_IOMgr.command OF
	
	OPEN:
		IF ((Out_AFDX_IOMgr.status = CLOSED) OR (Out_AFDX_IOMgr.status = IDLING)) THEN  

			(* open_AFDX_IOMgr(In_AFDX_IOMgr.number_of_ports, In_AFDX_IOMgr.number_of_rdata); *)
			open_AFDX_IOMgr();
	
			Out_AFDX_IOMgr.status		:= open_AFDX_IOMgr.status;	
			Out_AFDX_IOMgr.err_code		:= open_AFDX_IOMgr.err_code;	
			Out_AFDX_IOMgr.previous_index	:= In_AFDX_IOMgr.current_index;
			(*ft current_FV := 0;
			FV_counter := 0;*)

		END_IF; 
	LOAD:
		IF ((Out_AFDX_IOMgr.status = OPENED) OR (Out_AFDX_IOMgr.status = LOADING)) THEN 

			(* load_AFDX_IOMgr(In_AFDX_IOMgr.number_of_variables, rdata_base, In_rdata_user); *) 
			load_AFDX_IOMgr();


			Out_AFDX_IOMgr.status	:= load_AFDX_IOMgr.status;	
			Out_AFDX_IOMgr.err_code	:= load_AFDX_IOMgr.err_code;	

		END_IF; 
	INITIALIZE:
		IF (Out_AFDX_IOMgr.status = LOADED) THEN 

		(*	initialize_AFDX_IOMgr(In_AFDX_IOMgr.number_of_ports); *)
			initialize_AFDX_IOMgr();


			Out_AFDX_IOMgr.status	:= initialize_AFDX_IOMgr.status;	
			Out_AFDX_IOMgr.err_code	:= initialize_AFDX_IOMgr.err_code;	

		END_IF; 
	RUN:
		IF  ((Out_AFDX_IOMgr.status =  INITIALIZED)  OR (Out_AFDX_IOMgr.status = RUNNING) OR (Out_AFDX_IOMgr.status = ERROR_ON_RUNNING) ) THEN 

			run_AFDX_IOMgr( number_of_var); 
			
			Out_AFDX_IOMgr.status	:= run_AFDX_IOMgr.status;	
			Out_AFDX_IOMgr.err_code	:= run_AFDX_IOMgr.err_code;	

			(*CASE (In_AFDX_IOMgr.sub_command) OF
				XFER_COEFF:
					IF Out_AFDX_IOMgr.sub_status <> COEFF_XFERED THEN
						xfer_coefficients();
						Out_AFDX_IOMgr.sub_status := xfer_coefficients.sub_status;
					END_IF;

				CALIB:
					Cal_Update();
					Out_AFDX_IOMgr.sub_status := Cal_Update.sub_status;
					Out_AFDX_IOMgr.Cal_Raw 	:= Cal_Update.Cal_Raw;

				REQ_XFER_COEFF:
					XFER_COEFF_FLAG := XFER_COEFF_FLAG XOR TRUE;
					sub_command 	:= SUB_IDLE;
				
				ELSE					
					Out_AFDX_IOMgr.sub_status := 0;
				END_CASE;*)
			END_IF;
	CLOSE:
		IF  (Out_AFDX_IOMgr.status <> CLOSED) THEN 

			(* close_AFDX_IOMgr(In_AFDX_IOMgr.number_of_ports, rdata_base); *)
			close_AFDX_IOMgr();

			Out_AFDX_IOMgr.status	:= close_AFDX_IOMgr.status;	
			Out_AFDX_IOMgr.err_code	:= close_AFDX_IOMgr.err_code;	
			
		END_IF; 
	IDLE:
		Out_AFDX_IOMgr.status := IDLING;
	END_CASE; 













END_PROGRAM
