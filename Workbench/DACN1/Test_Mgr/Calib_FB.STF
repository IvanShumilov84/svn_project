FUNCTION_BLOCK Calib_FB
(************************************************************************************************************************************************
	Name :		Calib_FB									
														
	Description :	 							      

	Dependacy : 	

					HYSTORY
	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         					First Release

************************************************************************************************************************************************)	

	(* initialize output *)
	sub_status 	:= 0 ;
	Cal_Raw		:=123456.789;


	IF (Out_TM_Calib.Branch = 'DACN1_NIDAQ_IOMGR_REAL') THEN 
		Out_DACN1_NIDAQ_IOMgr.sub_command 		:= CALIB;
		sub_status 								:= In_DACN1_NIDAQ_IOMgr.sub_status ;
		Cal_Raw 								:= In_DACN1_NIDAQ_IOMgr.Cal_Raw ;
	END_IF; 

	IF (Out_TM_Calib.Branch = 'DACN1_SERIAL_IOMGR_REAL') THEN  
		Out_DACN1_Serial_IOMgr.sub_command 		:= CALIB;
		sub_status 								:= In_DACN1_Serial_IOMgr.sub_status ;
		Cal_Raw 								:= In_DACN1_Serial_IOMgr.Cal_Raw ;
	END_IF; 

	IF (Out_TM_Calib.Branch = 'DACN1_POWERDNA_IOMGR_REAL_1' OR Out_TM_Calib.Branch = 'DACN1_POWERDNA_IOMGR_REAL_2') THEN 
		Out_DACN1_PowerDNA_IOMgr.sub_command 	:= CALIB;
		sub_status 								:= In_DACN1_PowerDNA_IOMgr.sub_status ;
		Cal_Raw 								:= In_DACN1_PowerDNA_IOMgr.Cal_Raw ;
	END_IF;
	
	IF (Out_TM_Calib.Branch = 'DACN1_SCANIVALVE_IOMGR_REAL') THEN  
		IF (Out_TM_Calib.Prefix = 'P') THEN
			Out_DACN1_Scanivalve_Pressure_IOMgr.sub_command 	:= CALIB;
			sub_status 											:= In_DACN1_Scanivalve_Pressure_IOMgr.sub_status ;
			Cal_Raw 											:= In_DACN1_Scanivalve_Pressure_IOMgr.Cal_Raw ;
		ELSE
			Out_DACN1_Scanivalve_Temperature_IOMgr.sub_command 		:= CALIB;
			sub_status 											:= In_DACN1_Scanivalve_Temperature_IOMgr.sub_status ;
			Cal_Raw 											:= In_DACN1_Scanivalve_Temperature_IOMgr.Cal_Raw ;
		END_IF;
	END_IF; 
	
	

(* NEW CALCULATION COEFF *)
	IF Calib_calcul  = 444 THEN
		CASE Out_TM_Calib.degree OF
			1:
				Out_Calib_calcul := Calcul1( ) ;
			2:
				Out_Calib_calcul := Calcul1( ) ;
			3:
				Out_Calib_calcul := Calcul1( ) ;
 			4:
				Out_Calib_calcul := Calcul1( ) ;
		END_CASE ;
	ELSE
		(*  Reset InterLock *)
		Out_Calib_calcul := 111 ;
	END_IF ;














END_FUNCTION_BLOCK
