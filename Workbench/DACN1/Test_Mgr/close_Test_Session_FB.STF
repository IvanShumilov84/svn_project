FUNCTION_BLOCK close_Test_Session_FB
(************************************************************************************************************************************************
	Name :		close_Test_Session_FB									
														
	Description :	 							      

	Dependacy : 	

					HYSTORY
	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         					First Release

************************************************************************************************************************************************)	


	status := CLOSING;


	IF ((Out_DACN1_NIDAQ_IOMgr.disabled 				<> TRUE) AND (Out_DACN1_NIDAQ_IOMgr.command 				<> CLOSE)) THEN 
		Out_DACN1_NIDAQ_IOMgr.command					:= CLOSE;
	END_IF; 

	IF ((Out_DACN1_Serial_IOMgr.disabled 				<> TRUE) AND (Out_DACN1_Serial_IOMgr.command 				<> CLOSE)) THEN 
		Out_DACN1_Serial_IOMgr.command 					:= CLOSE;
	END_IF;

	IF ((Out_DACN1_Serial_Arinc_IOMgr.disabled 			<> TRUE) AND (Out_DACN1_Serial_Arinc_IOMgr.command 			<> CLOSE)) THEN 
		Out_DACN1_Serial_Arinc_IOMgr.command 			:= CLOSE;
	END_IF; 

	IF ((Out_DACN1_Omnibusbox_IOMgr.disabled 			<> TRUE) AND (Out_DACN1_Omnibusbox_IOMgr.command 			<> CLOSE)) THEN 
		Out_DACN1_Omnibusbox_IOMgr.command				:= CLOSE;
	END_IF;

	IF ((Out_DACN1_PowerDNA_IOMgr.disabled 				<> TRUE) AND (Out_DACN1_PowerDNA_IOMgr.command 				<> CLOSE)) THEN 
		Out_DACN1_PowerDNA_IOMgr.command				:= CLOSE;
	END_IF;

	IF ((Out_DACN1_Scanivalve_Temperature_IOMgr.disabled <> TRUE) AND (Out_DACN1_Scanivalve_Temperature_IOMgr.command <> CLOSE)) THEN 
		Out_DACN1_Scanivalve_Temperature_IOMgr.command	:= CLOSE;
	END_IF;

	IF ((Out_DACN1_Scanivalve_Pressure_IOMgr.disabled	<> TRUE) AND (Out_DACN1_Scanivalve_Pressure_IOMgr.command	<> CLOSE)) THEN 
		Out_DACN1_Scanivalve_Pressure_IOMgr.command		:= CLOSE;
	END_IF;

	IF ((Out_DACN1_SM1720_IOMgr.disabled 				<> TRUE) AND (Out_DACN1_SM1720_IOMgr.command 				<> CLOSE)) THEN 
		Out_DACN1_SM1720_IOMgr.command					:= CLOSE;
	END_IF;
	IF ((Out_DACN1_Galil_Controller.disabled 			<> TRUE) AND (Out_DACN1_Galil_Controller.command 			<> CLOSE)) THEN 
		Out_DACN1_Galil_Controller.command				:= CLOSE;
	END_IF;

	IF ((Out_DACN1_Texcel_V100_IOMgr.disabled			<> TRUE) AND (Out_DACN1_Texcel_V100_IOMgr.command			<> CLOSE)) THEN 
		Out_DACN1_Texcel_V100_IOMgr.command 			:= CLOSE;
	END_IF;

	IF ((Out_DACN1_Texcel_VX100_IOMgr.disabled			<> TRUE) AND (Out_DACN1_Texcel_VX100_IOMgr.command			<> CLOSE)) THEN 
		Out_DACN1_Texcel_VX100_IOMgr.command 			:= CLOSE;
	END_IF;

	IF ((Out_DACN1_UUT_Controller.disabled 				<> TRUE) AND (Out_DACN1_UUT_Controller.command 				<> CLOSE)) THEN 
		Out_DACN1_UUT_Controller.command 				:= CLOSE;
	END_IF; 

	IF ((Out_DACN1_User_Interface.disabled 				<> TRUE) AND (Out_DACN1_User_Interface.command 				<> CLOSE)) THEN 
		Out_DACN1_User_Interface.command 				:= CLOSE;
	END_IF;

	IF ((Out_DACN1_AFDX_IOMgr.disabled 					<> TRUE) AND (Out_DACN1_AFDX_IOMgr.command 					<> CLOSE)) THEN 
		Out_DACN1_AFDX_IOMgr.command 					:= CLOSE;
	END_IF;




	IF (		((Out_DACN1_NIDAQ_IOMgr.disabled 				= TRUE) OR (In_DACN1_NIDAQ_IOMgr.status					= CLOSED))
			AND	((Out_DACN1_Serial_IOMgr.disabled 				= TRUE) OR (In_DACN1_Serial_IOMgr.status				= CLOSED))
			AND	((Out_DACN1_Serial_Arinc_IOMgr.disabled 		= TRUE) OR (In_DACN1_Serial_Arinc_IOMgr.status			= CLOSED))
			AND	((Out_DACN1_Omnibusbox_IOMgr.disabled 			= TRUE) OR (In_DACN1_Omnibusbox_IOMgr.status  			= CLOSED))
			AND	((Out_DACN1_PowerDNA_IOMgr.disabled 			= TRUE) OR (In_DACN1_PowerDNA_IOMgr.status  			= CLOSED))
			AND	((Out_DACN1_Scanivalve_Temperature_IOMgr.disabled = TRUE) OR (In_DACN1_Scanivalve_Temperature_IOMgr.status = CLOSED))
			AND	((Out_DACN1_Scanivalve_Pressure_IOMgr.disabled	= TRUE)	OR (In_DACN1_Scanivalve_Pressure_IOMgr.status	= CLOSED))
			AND	((Out_DACN1_SM1720_IOMgr.disabled 				= TRUE) OR (In_DACN1_SM1720_IOMgr.status  				= CLOSED))
			AND	((Out_DACN1_Galil_Controller.disabled 			= TRUE) OR (In_DACN1_Galil_Controller.status  			= CLOSED))
			AND	((Out_DACN1_Texcel_V100_IOMgr.disabled 			= TRUE)	OR (In_DACN1_Texcel_V100_IOMgr.status			= CLOSED))
			AND	((Out_DACN1_Texcel_VX100_IOMgr.disabled 		= TRUE)	OR (In_DACN1_Texcel_VX100_IOMgr.status			= CLOSED))
			AND	((Out_DACN1_UUT_Controller.disabled 			= TRUE)	OR (In_DACN1_UUT_Controller.status				= CLOSED))
			AND	((Out_DACN1_User_Interface.disabled 			= TRUE)	OR (In_DACN1_User_Interface.status				= CLOSED))
			AND	((Out_DACN1_AFDX_IOMgr.disabled 				= TRUE)	OR (In_DACN1_AFDX_IOMgr.status					= CLOSED))


	    )  THEN 

		status 	:= CLOSED;

		(* Reset Model and substatus *)
		UUT_Info.Model := '' ;

		Out_DACN1_NIDAQ_IOMgr.command				:= IDLE;
		Out_DACN1_Serial_IOMgr.command				:= IDLE;
		Out_DACN1_Serial_Arinc_IOMgr.command		:= IDLE;
		Out_DACN1_Omnibusbox_IOMgr.command			:= IDLE;
		Out_DACN1_PowerDNA_IOMgr.command			:= IDLE;
		Out_DACN1_Scanivalve_Temperature_IOMgr.command:= IDLE;
		Out_DACN1_Scanivalve_Pressure_IOMgr.command	:= IDLE;
		Out_DACN1_SM1720_IOMgr.command				:= IDLE;
		Out_DACN1_Galil_Controller.command			:= IDLE;
		Out_DACN1_Texcel_V100_IOMgr.command			:= IDLE;
		Out_DACN1_Texcel_VX100_IOMgr.command		:= IDLE;
		Out_DACN1_UUT_Controller.command			:= IDLE;
		Out_DACN1_User_Interface.command			:= IDLE;
		Out_DACN1_AFDX_IOMgr.command				:= IDLE;

	END_IF; 


	IF (		(In_DACN1_NIDAQ_IOMgr.err_code					<> OK)
			OR	(In_DACN1_Serial_IOMgr.err_code					<> OK)
			OR	(In_DACN1_Serial_Arinc_IOMgr.err_code			<> OK)
			OR	(In_DACN1_Omnibusbox_IOMgr.err_code				<> OK)
			OR	(In_DACN1_PowerDNA_IOMgr.err_code				<> OK)
			OR	(In_DACN1_Scanivalve_Temperature_IOMgr.err_code	<> OK)
			OR	(In_DACN1_Scanivalve_Pressure_IOMgr.err_code	<> OK)
			OR	(In_DACN1_SM1720_IOMgr.err_code					<> OK)
			OR	(In_DACN1_Galil_Controller.err_code				<> OK)
			OR	(In_DACN1_Texcel_V100_IOMgr.err_code			<> OK)
			OR	(In_DACN1_Texcel_VX100_IOMgr.err_code			<> OK)
			OR 	(In_DACN1_UUT_Controller.err_code				<> OK) 
			OR 	(In_DACN1_User_Interface.err_code				<> OK)
			OR 	(In_DACN1_AFDX_IOMgr.err_code					<> OK)


	    )  THEN 

		status 		:= ERROR_ON_CLOSING;
		err_code 	:= ERROR_ON_CLOSING;	
	ELSE 
		err_code 	:= OK;
	END_IF; 








END_FUNCTION_BLOCK
