FUNCTION_BLOCK load_OMNIBUSBOX_FB
(************************************************************************************************************************************************
	Name :		load_OMNIBUSBOX_FB									
														
	Description :	Load of the OmniBusBox system.

	Dependacy : 	

					HYSTORY
	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         2005/02/09	Danny Lepage	First Release

************************************************************************************************************************************************)	

status 	 := LOADING;
err_code := OK;

IF (In_OMNIBUSBOX_IOMgr.Mode = RUN_FOR_TRUE) THEN

	IF (err_code = OK) THEN

		load_ARINC429();
		err_code := load_ARINC429.ERR_CODE;

	END_IF;

	IF (err_code = OK) THEN

		load_UART();
		err_code := load_UART.ERR_CODE;
	
	END_IF;

END_IF;


IF (err_code <> OK) THEN
	status := ERROR_ON_LOADING;
ELSE
	status := LOADED;
END_IF;













END_FUNCTION_BLOCK
