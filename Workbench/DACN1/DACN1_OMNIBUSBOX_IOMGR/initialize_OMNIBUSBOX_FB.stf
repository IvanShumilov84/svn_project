FUNCTION_BLOCK initialize_OMNIBUSBOX_FB
(************************************************************************************************************************************************
	Name :		Initialize_OMNIBUSBOX_FB									
														
	Description :	Initialization of the OMNIBUSBOX System 							      

	Dependacy : 	
					HYSTORY

	Rev		Date		Name			Description
		        (YYYY/MM/DD)

	1.0	  	2005/02/09	Danny Lepage		First Release

************************************************************************************************************************************************)

status := INITIALIZING;
err_code := OK ;

IF (In_OMNIBUSBOX_IOMgr.Mode = RUN_FOR_TRUE) THEN
	FOR i:= 1 TO numberOfBox by 1 DO
		FOR j:= 1 TO CELBTI_MAXCORES DO
			IF (boxDescriptor[i].core[j].hCore <> 0) THEN
				FOR k := 1 TO CELBTI_MAXCHANS DO

					(*
					 * Starts up all configured channels
					 *)

					IF (boxDescriptor[i].core[j].channel[k].isChannelUsed) THEN
						CASE boxDescriptor[i].core[j].channel[k].channelType OF
						CELBTI_CHTYPEA429:
							CELBTI_A429ChStart(boxDescriptor[i].core[j].hCore, ANY_TO_SINT(k-1));
							err_code := CELBTI_A429ChStart.ERR_CODE;
						CELBTI_CHTYPEUART:
							CELBTI_UARTPortStart(boxDescriptor[i].core[j].hCore, ANY_TO_SINT(k-1));
							err_code := CELBTI_UARTPortStart.ERR_CODE;
						END_CASE;
					END_IF;

					IF (err_code <> OK) THEN
						k := CELBTI_MAXCHANS;
					END_IF;
				END_FOR;

				(*
				 * Starts up the core
				 *)

				IF (err_code = OK) THEN
					CELBTI_CORESTART(boxDescriptor[i].core[j].hCore);
					err_code := CELBTI_CORESTART.ERR_CODE;
				END_IF;
			END_IF;

			IF (err_code <> OK) THEN
				j := CELBTI_MAXCORES;
			END_IF;
		END_FOR;

		IF (err_code <> OK) THEN
			i := numberOfBox;
		END_IF;
	END_FOR;
END_IF;

IF (err_code <> OK) THEN 
	status := ERROR_ON_INITIALIZING;
ELSE 
	status := INITIALIZED;
END_IF; 






END_FUNCTION_BLOCK
