PROGRAM MAIN
(************************************************************************************************************************************************
	Name :		MAIN									
														
	Description :	 							      

	Dependacy : 	
					HYSTORY

	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         					First Release
	2.0	          2002/10/17		N. Sangiovanni	Calibration modification

************************************************************************************************************************************************)	
	IF (First_Time_Trough = TRUE) THEN 
		First_Time_Trough := FALSE;
		Out_Scanivalve_Temp_IOMgr.status := IDLING;
		count_Xfer := 0;
	END_IF; 

	CASE  In_Scanivalve_Temp_IOMgr.command OF
	
	OPEN:
		IF ((Out_Scanivalve_Temp_IOMgr.status = CLOSED) OR (Out_Scanivalve_Temp_IOMgr.status = IDLING)) THEN  

			open_Scanivalve_IOMgr(In_Scanivalve_Temp_IOMgr.number_of_ports, In_Scanivalve_Temp_IOMgr.number_of_rdata);
	
			Out_Scanivalve_Temp_IOMgr.status			:= open_Scanivalve_IOMgr.status;	
			Out_Scanivalve_Temp_IOMgr.err_code			:= open_Scanivalve_IOMgr.err_code;	
			Out_Scanivalve_Temp_IOMgr.previous_index	:= In_Scanivalve_Temp_IOMgr.current_index;
			current_FV := 0;
			FV_counter := 0;

		END_IF; 
	LOAD:
		IF ((Out_Scanivalve_Temp_IOMgr.status = OPENED) OR (Out_Scanivalve_Temp_IOMgr.status = LOADING)) THEN 

			load_Scanivalve_IOMgr(In_Scanivalve_Temp_IOMgr.number_of_variables, rdata_base);

			Out_Scanivalve_Temp_IOMgr.status	:= load_Scanivalve_IOMgr.status;	
			Out_Scanivalve_Temp_IOMgr.err_code	:= load_Scanivalve_IOMgr.err_code;	

		END_IF; 
	INITIALIZE:
		IF (Out_Scanivalve_Temp_IOMgr.status = LOADED) THEN 

			initialize_Scanivalve_IOMgr(In_Scanivalve_Temp_IOMgr.number_of_ports);

			Out_Scanivalve_Temp_IOMgr.status	:= initialize_Scanivalve_IOMgr.status;	
			Out_Scanivalve_Temp_IOMgr.err_code	:= initialize_Scanivalve_IOMgr.err_code;	

		END_IF; 
	RUN:
		IF  ((Out_Scanivalve_Temp_IOMgr.status =  INITIALIZED)  OR (Out_Scanivalve_Temp_IOMgr.status = RUNNING)) THEN 

			run_Scanivalve_IOMgr( number_of_var);

			Out_Scanivalve_Temp_IOMgr.status	:= run_Scanivalve_IOMgr.status;	
			Out_Scanivalve_Temp_IOMgr.err_code	:= run_Scanivalve_IOMgr.err_code;	

			CASE (In_Scanivalve_Temp_IOMgr.sub_command) OF
				XFER_COEFF:
					IF Out_Scanivalve_Temp_IOMgr.sub_status <> COEFF_XFERED THEN
						xfer_coefficients();
						Out_Scanivalve_Temp_IOMgr.sub_status := xfer_coefficients.sub_status;
					END_IF;

				CALIB:
					Cal_Update();
					Out_Scanivalve_Temp_IOMgr.sub_status 	:= Cal_Update.sub_status;
					Out_Scanivalve_Temp_IOMgr.Cal_Raw 		:= Cal_Update.Cal_Raw;

				REQ_XFER_COEFF:
					XFER_COEFF_FLAG := XFER_COEFF_FLAG XOR TRUE;
					sub_command 	:= SUB_IDLE;
				
				ELSE					
					Out_Scanivalve_Temp_IOMgr.sub_status := 0;
				END_CASE;
			END_IF;
	CLOSE:
		IF  (Out_Scanivalve_Temp_IOMgr.status <> CLOSED) THEN 

			close_Scanivalve_IOMgr(In_Scanivalve_Temp_IOMgr.number_of_ports, rdata_base);

			Out_Scanivalve_Temp_IOMgr.status	:= close_Scanivalve_IOMgr.status;	
			Out_Scanivalve_Temp_IOMgr.err_code	:= close_Scanivalve_IOMgr.err_code;	
			
		END_IF; 
	IDLE:
		Out_Scanivalve_Temp_IOMgr.status := IDLING;
	END_CASE; 











END_PROGRAM
