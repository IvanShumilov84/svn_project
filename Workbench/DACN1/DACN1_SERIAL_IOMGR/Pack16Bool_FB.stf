FUNCTION_BLOCK Pack16Bool_FB
(************************************************************************************************************************************************
	Name :		Pack16Bool_FB									
														
	Description :	Get a int value from bits inputs 							      

	Dependacy : 	
					HYSTORY

	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         					First Release

************************************************************************************************************************************************)	
(* get int value from bits inputs *)
	FOR idx := 0 TO 15 DO
		CASE idx OF

		0:
			IF rev_log = TRUE THEN
				IF B_In0 = FALSE THEN
					hex1 := 1 ;
				ELSE
					hex1 := 0 ;
				END_IF ;
			ELSE
				IF B_In0 = TRUE THEN
					hex1 := 1 ;
				ELSE
					hex1 := 0 ;
				END_IF ;
			END_IF;

		1:
			IF rev_log = TRUE THEN
				IF B_In1 = FALSE THEN
					hex1 := hex1 + 2;
				END_IF ;
			ELSE
				IF B_In1 = TRUE THEN
					hex1 := hex1 + 2 ;
				END_IF ;
			END_IF;

		2:
			IF rev_log = TRUE THEN
				IF B_In2 = FALSE THEN
					hex1 := hex1 + 4;
				END_IF ;
			ELSE
				IF B_In2 = TRUE THEN
					hex1 := hex1 + 4 ;
				END_IF ;
			END_IF;

		3:
			IF rev_log = TRUE THEN
				IF B_In3 = FALSE THEN
					hex1 := hex1 + 8;
				END_IF ;
			ELSE
				IF B_In3 = TRUE THEN
					hex1 := hex1 + 8 ;
				END_IF ;
			END_IF;


		4:
			IF rev_log = TRUE THEN
				IF B_In4 = FALSE THEN
					hex2 := 1 ;
				ELSE
					hex2 := 0 ;
				END_IF ;
			ELSE
				IF B_In4 = TRUE THEN
					hex2 := 1 ;
				ELSE
					hex2 := 0 ;
				END_IF ;
			END_IF;

		5:
			IF rev_log = TRUE THEN
				IF B_In5 = FALSE THEN
					hex2 := hex2 + 2;
				END_IF ;
			ELSE
				IF B_In5 = TRUE THEN
					hex2 := hex2 + 2 ;
				END_IF ;
			END_IF;

		6:
			IF rev_log = TRUE THEN
				IF B_In6 = FALSE THEN
					hex2 := hex2 + 4;
				END_IF ;
			ELSE
				IF B_In6 = TRUE THEN
					hex2 := hex2 + 4 ;
				END_IF ;
			END_IF;

		7:
			IF rev_log = TRUE THEN
				IF B_In7 = FALSE THEN
					hex2 := hex2 + 8;
				END_IF ;
			ELSE
				IF B_In7 = TRUE THEN
					hex2 := hex2 + 8 ;
				END_IF ;
			END_IF;


		8:
			IF rev_log = TRUE THEN
				IF B_In8 = FALSE THEN
					hex3 := 1 ;
				ELSE
					hex3 := 0 ;
				END_IF ;
			ELSE
				IF B_In8 = TRUE THEN
					hex3 := 1 ;
				ELSE
					hex3 := 0 ;
				END_IF ;
			END_IF;

		9:
			IF rev_log = TRUE THEN
				IF B_In9 = FALSE THEN
					hex3 := hex3 + 2;
				END_IF ;
			ELSE
				IF B_In9 = TRUE THEN
					hex3 := hex3 + 2 ;
				END_IF ;
			END_IF;

		10:
			IF rev_log = TRUE THEN
				IF B_In10 = FALSE THEN
					hex3 := hex3 + 4;
				END_IF ;
			ELSE
				IF B_In10 = TRUE THEN
					hex3 := hex3 + 4 ;
				END_IF ;
			END_IF;

		11:
			IF rev_log = TRUE THEN
				IF B_In11 = FALSE THEN
					hex3 := hex3 + 8;
				END_IF ;
			ELSE
				IF B_In11 = TRUE THEN
					hex3 := hex3 + 8 ;
				END_IF ;
			END_IF;


		12:
			IF rev_log = TRUE THEN
				IF B_In12 = FALSE THEN
					hex4 := 1 ;
				ELSE
					hex4 := 0 ;
				END_IF ;
			ELSE
				IF B_In12 = TRUE THEN
					hex4 := 1 ;
				ELSE
					hex4 := 0 ;
				END_IF ;
			END_IF;

		13:
			IF rev_log = TRUE THEN
				IF B_In13 = FALSE THEN
					hex4 := hex4 + 2;
				END_IF ;
			ELSE
				IF B_In13 = TRUE THEN
					hex4 := hex4 + 2 ;
				END_IF ;
			END_IF;

		14:
			IF rev_log = TRUE THEN
				IF B_In14 = FALSE THEN
					hex4 := hex4 + 4;
				END_IF ;
			ELSE
				IF B_In14 = TRUE THEN
					hex4 := hex4 + 4 ;
				END_IF ;
			END_IF;

		15:
			IF rev_log = TRUE THEN
				IF B_In15 = FALSE THEN
					hex4 := hex4 + 8;
				END_IF ;
			ELSE
				IF B_In15 = TRUE THEN
					hex4 := hex4 + 8 ;
				END_IF ;
			END_IF;
		END_CASE;
	END_FOR ;



(* Build the string *)
	FOR bit_idx := 1 TO 4 DO
		CASE bit_idx OF
		1:
			CASE hex1 OF
			0:	Val_Hex := '0' ;
			1:	Val_Hex := '1' ;
			2:	Val_Hex := '2' ;
			3:	Val_Hex := '3' ;
			4:	Val_Hex := '4' ;
			5:	Val_Hex := '5' ;
			6:	Val_Hex := '6' ;
			7:	Val_Hex := '7' ;
			8:	Val_Hex := '8' ;
			9:	Val_Hex := '9' ;
			10:	Val_Hex := 'A' ;
			11:	Val_Hex := 'B' ;
			12:	Val_Hex := 'C' ;
			13:	Val_Hex := 'D' ;
			14:	Val_Hex := 'E' ;
			15:	Val_Hex := 'F' ;
			END_CASE;

		2:
			CASE hex2 OF
			0:	Val_Hex := INSERT( Val_Hex, '0',1 ) ;
			1:	Val_Hex := INSERT( Val_Hex, '1',1 ) ;
			2:	Val_Hex := INSERT( Val_Hex, '2',1 ) ;
			3:	Val_Hex := INSERT( Val_Hex, '3',1 ) ;
			4:	Val_Hex := INSERT( Val_Hex, '4',1 ) ;
			5:	Val_Hex := INSERT( Val_Hex, '5',1 ) ;
			6:	Val_Hex := INSERT( Val_Hex, '6',1 ) ;
			7:	Val_Hex := INSERT( Val_Hex, '7',1 ) ;
			8:	Val_Hex := INSERT( Val_Hex, '8',1 ) ;
			9:	Val_Hex := INSERT( Val_Hex, '9',1 ) ;
			10:	Val_Hex := INSERT(Val_Hex, 'A',1 ) ;
			11:	Val_Hex := INSERT(Val_Hex, 'B',1 ) ;
			12:	Val_Hex := INSERT(Val_Hex, 'C',1 ) ;
			13:	Val_Hex := INSERT(Val_Hex, 'D',1 ) ;
			14:	Val_Hex := INSERT(Val_Hex, 'E',1 ) ;
			15:	Val_Hex := INSERT(Val_Hex, 'F',1 ) ;
			END_CASE;

		3:
			CASE hex3 OF
			0:	Val_Hex := INSERT( Val_Hex, '0',1 ) ;
			1:	Val_Hex := INSERT( Val_Hex, '1',1 ) ;
			2:	Val_Hex := INSERT( Val_Hex, '2',1 ) ;
			3:	Val_Hex := INSERT( Val_Hex, '3',1 ) ;
			4:	Val_Hex := INSERT( Val_Hex, '4',1 ) ;
			5:	Val_Hex := INSERT( Val_Hex, '5',1 ) ;
			6:	Val_Hex := INSERT( Val_Hex, '6',1 ) ;
			7:	Val_Hex := INSERT( Val_Hex, '7',1 ) ;
			8:	Val_Hex := INSERT( Val_Hex, '8',1 ) ;
			9:	Val_Hex := INSERT( Val_Hex, '9',1 ) ;
			10:	Val_Hex := INSERT(Val_Hex, 'A',1 ) ;
			11:	Val_Hex := INSERT(Val_Hex, 'B',1 ) ;
			12:	Val_Hex := INSERT(Val_Hex, 'C',1 ) ;
			13:	Val_Hex := INSERT(Val_Hex, 'D',1 ) ;
			14:	Val_Hex := INSERT(Val_Hex, 'E',1 ) ;
			15:	Val_Hex := INSERT(Val_Hex, 'F',1 ) ;
			END_CASE;

		4:
			CASE hex4 OF
			0:	Val_Hex := INSERT( Val_Hex, '0',1 ) ;
			1:	Val_Hex := INSERT( Val_Hex, '1',1 ) ;
			2:	Val_Hex := INSERT( Val_Hex, '2',1 ) ;
			3:	Val_Hex := INSERT( Val_Hex, '3',1 ) ;
			4:	Val_Hex := INSERT( Val_Hex, '4',1 ) ;
			5:	Val_Hex := INSERT( Val_Hex, '5',1 ) ;
			6:	Val_Hex := INSERT( Val_Hex, '6',1 ) ;
			7:	Val_Hex := INSERT( Val_Hex, '7',1 ) ;
			8:	Val_Hex := INSERT( Val_Hex, '8',1 ) ;
			9:	Val_Hex := INSERT( Val_Hex, '9',1 ) ;
			10:	Val_Hex := INSERT(Val_Hex, 'A',1 ) ;
			11:	Val_Hex := INSERT(Val_Hex, 'B',1 ) ;
			12:	Val_Hex := INSERT(Val_Hex, 'C',1 ) ;
			13:	Val_Hex := INSERT(Val_Hex, 'D',1 ) ;
			14:	Val_Hex := INSERT(Val_Hex, 'E',1 ) ;
			15:	Val_Hex := INSERT(Val_Hex, 'F',1 ) ;
			END_CASE;
		END_CASE;
	END_FOR;


END_FUNCTION_BLOCK
