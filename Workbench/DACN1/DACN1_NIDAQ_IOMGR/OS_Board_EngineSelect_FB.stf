FUNCTION_BLOCK OS_Board_EngineSelect_FB
EngineSelected := MAX(0, EngineNo - 1);

FOR Index := 0 TO 4 DO
  (* Assign Least Significant bit to current DOUT *)
  Bits[Index] := AND_MASK(EngineSelected, 1) = 1;
  (* Next DOUT will be next power of 2, shift bits right *)
  EngineSelected := SHR(EngineSelected, 1);
END_FOR;

(* These DOUTs are active low *)

DOUT[OS_BOARD_ENGINE_SELECT_BIT0_DOUT_INDEX] := NOT(Bits[0]);
DOUT[OS_BOARD_ENGINE_SELECT_BIT1_DOUT_INDEX] := NOT(Bits[1]);
DOUT[OS_BOARD_ENGINE_SELECT_BIT2_DOUT_INDEX] := NOT(Bits[2]);
DOUT[OS_BOARD_ENGINE_SELECT_BIT3_DOUT_INDEX] := NOT(Bits[3]);
DOUT[OS_BOARD_ENGINE_SELECT_BIT4_DOUT_INDEX] := NOT(Bits[4]);


DOUT[OS_BOARD_N1_BOARD_DIV1_DOUT_INDEX]:= OS_BOARD_ENGINE_CFGS[EngineNo].N1_BOARD.DIV1_ONOFF;
DOUT[OS_BOARD_N1_BOARD_DIV2_DOUT_INDEX]:= OS_BOARD_ENGINE_CFGS[EngineNo].N1_BOARD.DIV2_ONOFF;

DOUT[OS_BOARD_N2_BOARD_DIV1_DOUT_INDEX]:= OS_BOARD_ENGINE_CFGS[EngineNo].N2_BOARD.DIV1_ONOFF;
DOUT[OS_BOARD_N2_BOARD_DIV2_DOUT_INDEX]:= OS_BOARD_ENGINE_CFGS[EngineNo].N2_BOARD.DIV2_ONOFF;

DOUT[OS_BOARD_N3_BOARD_DIV1_DOUT_INDEX]:= OS_BOARD_ENGINE_CFGS[EngineNo].N3_BOARD.DIV1_ONOFF;
DOUT[OS_BOARD_N3_BOARD_DIV2_DOUT_INDEX]:= OS_BOARD_ENGINE_CFGS[EngineNo].N3_BOARD.DIV2_ONOFF;

DOUT[OS_BOARD_N4_BOARD_DIV1_DOUT_INDEX]:= OS_BOARD_ENGINE_CFGS[EngineNo].N4_BOARD.DIV1_ONOFF;
DOUT[OS_BOARD_N4_BOARD_DIV2_DOUT_INDEX]:= OS_BOARD_ENGINE_CFGS[EngineNo].N4_BOARD.DIV2_ONOFF;














END_FUNCTION_BLOCK
