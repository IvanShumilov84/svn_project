FUNCTION_BLOCK open_UUT_Ctrl_APS2000_FB
	
	IF (err_code <> OK) THEN 
		status	:= ERROR_ON_OPENING;
		dummy	:= LOG_MSG('ErrLog', 'DACN1_UUT_CRUNCHER: ERROR ON OPENING');		
	ELSE


		(* SPEED *)
		NG_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.NG_BINDING_SOURCE', '0'));
		NG_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.NG_INDEX', '0');
		NG_100_RPM 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.APS2000.NG_100_RPM_CONSTANT', '0');
		NG_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.APS2000.NG_100_FREQ_CONSTANT', '0');


		(* T_EGT_P *)
		T_EGT_P_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_P_PROBE_BINDING_SOURCE', '0'));
		T_EGT_P_ENGINE_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_P_PROBE_INDEX1', '0');
		T_EGT_P_ENGINE_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_P_PROBE_INDEX2', '0');


		(* T_EGT *)
		T_EGT_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_BINDING_SOURCE', '0'));
		T_EGT_NUMBER_PROBE   := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_NUMBER_PROBE', '0');
		T_EGT_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX1', '0');
		T_EGT_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX2', '0');
		T_EGT_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX3', '0');
		T_EGT_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX4', '0');
		T_EGT_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX5', '0');
		T_EGT_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX6', '0');
		T_EGT_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX7', '0');
		T_EGT_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX8', '0');
		T_EGT_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX9', '0');
		T_EGT_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_EGT_PROBE_INDEX10', '0');

	

		(* T_INLET *)
		(*
		T_INLET_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_BINDING_SOURCE', '0'));
		T_INLET_NUMBER_PROBE 		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_NUMBER_PROBE', '0');

		T_INLET_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX1', '0');
		T_INLET_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX2', '0');
		T_INLET_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX3', '0');
		T_INLET_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX4', '0');
		T_INLET_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX5', '0');
		T_INLET_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX6', '0');
		T_INLET_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX7', '0');
		T_INLET_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX8', '0');
		T_INLET_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX9', '0');
		T_INLET_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_INLET_PROBE_INDEX10', '0');
		*)
	
		(* T_OIL *)
		T_OIL_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.T_OIL_PROBE_BINDING_SOURCE', '0'));
		T_OIL_PROBE_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.T_OIL_PROBE_INDEX', '0');



		(* P_OIL *)
		P_OIL_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.P_OIL_PROBE_BINDING_SOURCE', '0'));
		P_OIL_PROBE_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.P_OIL_PROBE_INDEX', '0');
	

		(* RTL *)
		RTL_DIN_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.RTL_DIN_BINDING_SOURCE', '0'));
		RTL_DIN_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.RTL_DIN_INDEX', '0');

		(* E_STOP_ECB *)
		E_STOP_ECB_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.E_STOP_ECB_CMD_BINDING_SOURCE', '0'));
		E_STOP_ECB_CMD_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.E_STOP_ECB_CMD_INDEX', '0');

		(* E_STOP_DAS FROM FACILITY XML SECTION *)
		E_STOP_DAS_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.FACILITY.E_STOP_DAS_CMD_BINDING_SOURCE', '0'));
		E_STOP_DAS_CMD_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.FACILITY.E_STOP_DAS_CMD_INDEX', '0');

		(* APU_FAULT *)
		APU_FAULT_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.APU_FAULT_BINDING_SOURCE', '0'));
		APU_FAULT_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.APU_FAULT_INDEX', '0');


		(* APU_STOP_CMD *)
		APU_STOP_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.APU_STOP_CMD_BINDING_SOURCE', '0'));
		APU_STOP_CMD_INDEX		:=  ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.APU_STOP_CMD_INDEX', '0');

		(* STARTER_ENGAGED_IND *)
		STARTER_ENGAGED_IND_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS2000.STARTER_ENGAGED_IND_BINDING_SOURCE', '0'));
		STARTER_ENGAGED_IND_INDEX		:=  ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS2000.STARTER_ENGAGED_IND_INDEX', '0');



		(* Reinit variables *)
        Accel_Init := FALSE;
		AccelerationTime_Value		:= 0.0;
		StarterCutoutTime_Value 	:= 0.0;
		TEgt_P_Avg_Max             	:= 0.0;
        TEgt_Avg_Max               	:= 0.0;
		VibGearboxMax_Value     	:= 0.0;
		VibTurbineMax_Value     	:= 0.0;
		POilMax_Value           	:= 0.0;
		NG_Speed_Max_Value 			:= 0.0;


		
		Start_Acceleration_Latch(FALSE,TRUE); (*Reset Latch*)
		Acceleration_Timer(FALSE, t#300s);    (*Reset Timer*)

		TIME_RUN := 0.0;
		TIME_RUN_Latch(FALSE,TRUE);	(*Reset Latch*)
		TIME_RUN_Timer(FALSE, t#8h);	(*Reset Timer*)

		TIME_RUN_DOWN := 0.0;
		TIME_RUN_DOWN_Latch(FALSE,TRUE);	(*Reset Latch*)
		TIME_RUN_DOWN_Timer(FALSE, t#8h);	(*Reset Timer*)

		ET_CRANK := 0.0;
		ET_CRANK_Latch(FALSE,TRUE);	(*Reset Latch*)
		ET_CRANK_Timer(FALSE, t#300s);	(*Reset Timer*)


		ET_100 := 0.0;
		ET_100_Latch(FALSE,TRUE);	(*Reset Latch*)
		ET_100_Timer(FALSE, t#300s);	(*Reset Timer*)

		ET_SIP := 0.0;
		ET_SIP_Latch(FALSE,TRUE);	(*Reset Latch*)
		ET_SIP_Timer(FALSE, t#300s);	(*Reset Timer*)

	END_IF;




END_FUNCTION_BLOCK
