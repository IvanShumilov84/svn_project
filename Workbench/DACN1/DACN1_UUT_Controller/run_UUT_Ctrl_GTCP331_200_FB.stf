 FUNCTION_BLOCK run_UUT_Ctrl_GTCP331_200_FB
(************************************************************************************************************************************************
	Name :		run_UUT_Ctrl_GTCP331_200_FB									
														
************************************************************************************************************************************************)	

	status 		:= RUNNING;
	(*dummy		:= LOG_MSG('ErrLog', 'DACN1_UUT_CONTROLLER: RUNNING');*)
	err_code 	:= OK;


	(* ETC tEMPERATURE *)
	FOR i:= 1 TO ETC_NUMBER_PROBE BY 1 DO
		CASE 	ANY_TO_DINT ( ETC_PROBE_BINDING_SOURCE ) OF
			BINDING_DACN1_NIDAQ_IOMGR_VIN:
				ETC_ENGINE_PROBE[i] := DACN1_NIDAQ_IOMGR_VIN[ ETC_ENGINE_PROBE_INDEX[i] ].Mean_Value;

			BINDING_DACN1_POWERDNA_IOMGR_T:
				ETC_ENGINE_PROBE[i] := DACN1_POWERDNA_IOMGR_T[ ETC_ENGINE_PROBE_INDEX[i] ].Mean_Value;

			BINDING_DACN1_SERIAL_IOMGR_T:
				ETC_ENGINE_PROBE[i] := DACN1_SERIAL_IOMGR_T[ ETC_ENGINE_PROBE_INDEX[i] ].Mean_Value;
		ELSE
			err_code := -2;
			dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_GTCP331_200: ETC_PROBE_BINDING_SOURCE NOT SUPPORTED');
			RETURN;

		END_CASE;         
	END_FOR;

	(* N1 Speed *)
	CASE 	ANY_TO_DINT ( N1_BINDING_SOURCE ) OF
			BINDING_DACN1_NIDAQ_IOMGR_F:
				N1_Freq := DACN1_NIDAQ_IOMGR_F[N1_INDEX].Mean_Value;        (* N1 Frequence *)
	ELSE
			err_code := -4;
			dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_GTCP331_200: N1_BINDING_SOURCE NOT SUPPORTED');
			RETURN;

	END_CASE;  


	CASE 	ANY_TO_DINT ( N1_95_BINDING_SOURCE ) OF
		BINDING_DACN1_SERIAL_IOMGR_DIN:
			N1_95_IND := DACN1_SERIAL_IOMGR_DIN[N1_95_INDEX]; 	(* 95% ON N1 signal *)
	ELSE
			err_code := -6;
			dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_GTCP331_200: N1_95_BINDING_SOURCE NOT SUPPORTED');
			RETURN;

	END_CASE;

      (* Fin definition des signaux *)


	IF (N1_Freq < 100.0) THEN

		N1_Speed 		:= 0.0;
		N1_Speed_PCT 	:= 0.0;

	ELSE 

		N1_Speed		:= (N1_Freq * N1_100_RPM) / N1_100_FREQ;
		N1_Speed_PCT	:= (N1_Freq / N1_100_FREQ ) * 100.0;

	END_IF;

	(* For the GTCP331-200 Family there is two overtemp types, One in function of the engine speed at startup and the one 
	   when the engine is running at 100% RPM *)

	(* Note that each EGT engine Probe has a specific temperature curve on startup *)

	(* Using 98% in case of fluctuations at steady state *)


	(* EGT Probe 1 *)

	IF N1_Speed_PCT < 98.0 THEN (* Trip point when engine is accelerating *)


		IF (N1_Speed_PCT <= EGT1_VS_N1_X[1]) THEN

			UUT_Trip_T[1].Trip_Point	:= EGT1_VS_N1_Y[1];

		ELSIF (N1_Speed_PCT >= EGT1_VS_N1_X[1] AND N1_Speed_PCT <= EGT1_VS_N1_X[2]) THEN

			Slope				:= (EGT1_VS_N1_Y[2] - EGT1_VS_N1_Y[1]) / (EGT1_VS_N1_X[2] - EGT1_VS_N1_X[1]);
			Offset				:= EGT1_VS_N1_Y[1] - (Slope * EGT1_VS_N1_X[1]);
			UUT_Trip_T[1].Trip_Point	:= N1_Speed_PCT * Slope + Offset;

		ELSIF (N1_Speed_PCT >= EGT1_VS_N1_X[2] AND N1_Speed_PCT <= EGT1_VS_N1_X[3]) THEN

			Slope				:= (EGT1_VS_N1_Y[3] - EGT1_VS_N1_Y[2]) / (EGT1_VS_N1_X[3] - EGT1_VS_N1_X[2]);
			Offset				:= EGT1_VS_N1_Y[2] - (Slope * EGT1_VS_N1_X[2]);
			UUT_Trip_T[1].Trip_Point	:= N1_Speed_PCT * Slope + Offset;

		ELSIF (N1_Speed_PCT >= EGT1_VS_N1_X[3] AND N1_Speed_PCT <= EGT1_VS_N1_X[4]) THEN

			Slope				:= (EGT1_VS_N1_Y[4] - EGT1_VS_N1_Y[3]) / (EGT1_VS_N1_X[4] - EGT1_VS_N1_X[3]);
			Offset				:= EGT1_VS_N1_Y[3] - (Slope * EGT1_VS_N1_X[3]);
			UUT_Trip_T[1].Trip_Point	:= N1_Speed_PCT * Slope + Offset;

		ELSE

			UUT_Trip_T[1].Trip_Point 	:= EGT1_VS_N1_Y[4];

		END_IF;


	ELSE (* Trip point when engine is running at 100% RPM *)
		
			UUT_Trip_T[1].Trip_Point 	:= EGT1_VS_N1_Y[4];
	END_IF;


	(* EGT Probe 2 *)

	IF N1_Speed_PCT < 98.0 THEN (* Trip point when engine is accelerating *)

		IF (N1_Speed_PCT <= EGT2_VS_N1_X[1]) THEN

			UUT_Trip_T[2].Trip_Point	:= EGT2_VS_N1_Y[1];

		ELSIF (N1_Speed_PCT >= EGT2_VS_N1_X[1] AND N1_Speed_PCT <= EGT2_VS_N1_X[2]) THEN

			Slope				:= (EGT2_VS_N1_Y[2] - EGT2_VS_N1_Y[1]) / (EGT2_VS_N1_X[2] - EGT2_VS_N1_X[1]);
			Offset				:= EGT2_VS_N1_Y[1] - (Slope * EGT2_VS_N1_X[1]);
			UUT_Trip_T[2].Trip_Point	:= N1_Speed_PCT * Slope + Offset;

		ELSIF (N1_Speed_PCT >= EGT2_VS_N1_X[2] AND N1_Speed_PCT <= EGT2_VS_N1_X[3]) THEN

			Slope				:= (EGT2_VS_N1_Y[3] - EGT2_VS_N1_Y[2]) / (EGT2_VS_N1_X[3] - EGT2_VS_N1_X[2]);
			Offset				:= EGT2_VS_N1_Y[2] - (Slope * EGT2_VS_N1_X[2]);
			UUT_Trip_T[2].Trip_Point	:= N1_Speed_PCT * Slope + Offset;

		ELSIF (N1_Speed_PCT >= EGT2_VS_N1_X[3] AND N1_Speed_PCT <= EGT2_VS_N1_X[4]) THEN

			Slope				:= (EGT2_VS_N1_Y[4] - EGT2_VS_N1_Y[3]) / (EGT2_VS_N1_X[4] - EGT2_VS_N1_X[3]);
			Offset				:= EGT2_VS_N1_Y[3] - (Slope * EGT2_VS_N1_X[3]);
			UUT_Trip_T[2].Trip_Point	:= N1_Speed_PCT * Slope + Offset;

		ELSE

			UUT_Trip_T[2].Trip_Point 	:= EGT2_VS_N1_Y[4];

		END_IF;

	ELSE (* Trip point when engine is running at 100% RPM *)
		
			UUT_Trip_T[2].Trip_Point 	:= EGT2_VS_N1_Y[4];
	END_IF;


(*	UUT_Trip_T[1].Trip_Point	:=	;*)
(*	UUT_Trip_T[2].Trip_Point	:=	;*)
	UUT_Trip_T[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.T3;
	UUT_Trip_T[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.T4;

	UUT_Trip_F[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.F1;
	UUT_Trip_F[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.F2;
	UUT_Trip_F[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.F3;
	UUT_Trip_F[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.F4;

	UUT_Trip_N[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.N1;
	UUT_Trip_N[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.N2;
	UUT_Trip_N[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.N3;
	UUT_Trip_N[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.N4;

	UUT_Trip_P[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.P1;
	UUT_Trip_P[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.P2;
	UUT_Trip_P[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.P3;
	UUT_Trip_P[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.P4;

	UUT_Trip_Q[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q1;
	UUT_Trip_Q[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q2;
	UUT_Trip_Q[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q3;
	UUT_Trip_Q[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q4;

	UUT_Trip_V[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.V1;
	UUT_Trip_V[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.V2;
	UUT_Trip_V[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.V3;
	UUT_Trip_V[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.V4;

	UUT_Trip_VIB[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB1;
	UUT_Trip_VIB[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB2;
	UUT_Trip_VIB[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB3;
	UUT_Trip_VIB[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB4;


	FOR i:= 1 TO ETC_NUMBER_PROBE BY 1 DO
			UUT_Trip_T[i].Trip_Source := ETC_ENGINE_PROBE[i] ;
	END_FOR;

(*	UUT_Trip_T[3].Trip_Source	:=	;*)
(*	UUT_Trip_T[4].Trip_Source	:=	;*)


(*	UUT_Trip_F[1].Trip_Source	:=	;*)
(*	UUT_Trip_F[2].Trip_Source	:=	;*)
(*	UUT_Trip_F[3].Trip_Source	:=	;*)
(*	UUT_Trip_F[4].Trip_Source	:=	;*)

	UUT_Trip_N[1].Trip_Source	:=	N1_Speed;
(*	UUT_Trip_N[2].Trip_Source	:=	;*)
(*	UUT_Trip_N[3].Trip_Source	:=	;*)
(*	UUT_Trip_N[4].Trip_Source	:=	;*)

(*	UUT_Trip_P[1].Trip_Source	:=	;*)
(*	UUT_Trip_P[2].Trip_Source	:=	;*)
(*	UUT_Trip_P[3].Trip_Source	:=	;*)
(*	UUT_Trip_P[4].Trip_Source	:=	;*)

(*	UUT_Trip_Q[1].Trip_Source	:=	;*)
(*	UUT_Trip_Q[2].Trip_Source	:=	;*)
(*	UUT_Trip_Q[3].Trip_Source	:=	;*)
(*	UUT_Trip_Q[4].Trip_Source	:=	;*)

(*	UUT_Trip_V[1].Trip_Source	:=	;*)
(*	UUT_Trip_V[2].Trip_Source	:=	;*)
(*	UUT_Trip_V[3].Trip_Source	:=	;*)
(*	UUT_Trip_V[4].Trip_Source	:=	;*)

(*	UUT_Trip_VIB[1].Trip_Source	:=	;*)
(*	UUT_Trip_VIB[2].Trip_Source	:=	;*)
(*	UUT_Trip_VIB[3].Trip_Source	:=	;*)
(*	UUT_Trip_VIB[4].Trip_Source	:=	;*)


EGT1_Limit := UUT_Trip_T[1].Trip_Point;
EGT2_Limit := UUT_Trip_T[2].Trip_Point;







END_FUNCTION_BLOCK
