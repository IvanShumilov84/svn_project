FUNCTION_BLOCK run_UUT_Ctrl_PT6A_FB
(************************************************************************************************************************************************
	Name :		run_UUT_Ctrl_PT6A_FB									
														
	Description :	Routine for  UUT Controller PT6A
				
				!! Original File has been imported from PW200 config !!						      

	Dependacy : 	

					HISTORY
	Rev			Date			Name			Description
		     		(YYYY/MM/DD)

	1.0	         	2015/09/ 		?.....		First Release
	2.0	         	2015/09/22		A. Armand		Change T_INLET_xx AND T_EGT_xx to T_T1_xx AND T_T7_xx
	2.1	         	2015/11/10		A. Armand		Added: -  Handle T5 TRIP for PT6A-41 according to BS
											 -  Changed Torque_Source
	
************************************************************************************************************************************************)	


	status 		:= RUNNING;
	(*dummy		:= LOG_MSG('ErrLog', 'DACN1_UUT_CONTROLLER: RUNNING');*)
	err_code 	:= OK;

	
	(* NG *)
	(* 37468 RPM @ 12600 Hz *)


	(* NF *)
	(* PT6A-6  -6A, -6B / PT6A-20 -20A -20B *)
	(* 33000  RPM @ 12600 Hz   *)

	(* PT6A-15AG / PT6A-27/-28 / PT6A-25C / Nf PT6A-34/-34AG/-34B/-35/-36 / PT6A-38 -41 -42 -42A / PT6A-52 / PT6A-61 / PT6A-64 *)
	(* 33235   RPM @ 12600 Hz   *)


	(* PT6A-11/-11AG/-110/-121 / PT6A-21 / PT6A-25-25A  PT6A-114/-114A/-135/-135A *)
	(* 32992  RPM @ 12600 Hz   *)

	(* PT6A-60A/PT6A-60AG / PT6A-65B -65R -65AR -65AG / PT6A-67 -67A -67AF -67AG -67R -67T / PT6A-67B -67D  67P *)
	(* 29894  RPM @ 12600 Hz   *)

	(* PT6A-67F *)
	(* 29564  RPM @ 12600 Hz   *)



	(* Limits are expressed in % *)

	(* NG *)
	CASE 	ANY_TO_DINT ( NG_BINDING_SOURCE ) OF

		BINDING_DACN1_NIDAQ_IOMGR_F:
			NG_HZ	:=DACN1_NIDAQ_IOMGR_F[ NG_INDEX ].Mean_Value; 		
	ELSE
		err_code := -1;
		dummy		:= LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PT6A: NG_BINDING_SOURCE NOT SUPPORTED');
		RETURN;

	END_CASE;   
      
	NG_Speed_RPM	:= (NG_HZ * NG_100_RPM) / NG_100_FREQ;
	NG_Speed_PCT	:= (NG_HZ / NG_100_FREQ ) * 100.0;

	(* NF *)
	CASE 	ANY_TO_DINT ( NF_BINDING_SOURCE ) OF

		BINDING_DACN1_NIDAQ_IOMGR_F:
			NF_HZ :=DACN1_NIDAQ_IOMGR_F[ NF_INDEX ].Mean_Value; 		
	ELSE
		err_code := -2;
		dummy		:= LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PT6A: NF_BINDING_SOURCE NOT SUPPORTED');
		RETURN;

	END_CASE;   
      
	NF_Speed_RPM	:= (NF_HZ * NF_100_RPM) / NF_100_FREQ;
	NF_Speed_PCT	:= (NF_HZ / NF_100_FREQ ) * 100.0;


	(* TExhaust corresponds physically to ITT (Interturbine Temperature = T5 Probe, converted from degre C to F *)


	IF ( (UUT_Info.Model = 'PT6A-6') OR (UUT_Info.Model = 'PT6A-6A') OR (UUT_Info.Model = 'PT6A-6B') ) THEN

		CASE 	ANY_TO_DINT ( T_T4_PROBE_BINDING_SOURCE) OF

			BINDING_DACN1_POWERDNA_IOMGR_T:

				TExhaust		:= DACN1_POWERDNA_IOMGR_T[T_T4_INDEX].Mean_Value;
		
			BINDING_DACN1_NIDAQ_IOMGR_VIN:

				TExhaust		:= DACN1_NIDAQ_IOMGR_VIN[T_T4_INDEX].Mean_Value;

			BINDING_DACN1_SERIAL_IOMGR_T:

				TExhaust		:= DACN1_SERIAL_IOMGR_T[T_T4_INDEX].Mean_Value;

		ELSE
			err_code := -3;
			dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PT6A: T_T4_PROBE_BINDING_SOURCE NOT SUPPORTED');
			RETURN;
	
		END_CASE;
	ELSE 
		CASE 	ANY_TO_DINT ( T_T5_PROBE_BINDING_SOURCE) OF

			BINDING_DACN1_POWERDNA_IOMGR_T:

				TExhaust		:= DACN1_POWERDNA_IOMGR_T[T_T5_INDEX].Mean_Value;
		
			BINDING_DACN1_NIDAQ_IOMGR_VIN:

				TExhaust		:= DACN1_NIDAQ_IOMGR_VIN[T_T5_INDEX].Mean_Value;

			BINDING_DACN1_SERIAL_IOMGR_T:

				TExhaust		:= DACN1_SERIAL_IOMGR_T[T_T5_INDEX].Mean_Value;

		ELSE
			err_code := -4;
			dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PT6A: T_T5_PROBE_BINDING_SOURCE NOT SUPPORTED');
			RETURN;
	
		END_CASE;

	END_IF;


	CASE 	ANY_TO_DINT ( TORQUE_BINDING_SOURCE) OF

		BINDING_DACN1_POWERDNA_IOMGR_P:

			Torque_Source		:= DACN1_POWERDNA_IOMGR_P[TORQUE_INDEX].Mean_Value;
		
		BINDING_DACN1_NIDAQ_IOMGR_P:

			Torque_Source		:= DACN1_NIDAQ_IOMGR_P[TORQUE_INDEX].Mean_Value;

	ELSE
		err_code := -5;
		dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PT6A: TORQUE_BINDING_SOURCE NOT SUPPORTED');
		RETURN;
	
	END_CASE;

	DynoSpeed_Source	:= Dyno_Speed;


	(* TT1, TT7 We need to calculate an average on QNX as Performance Computer manage *)
	(* average with delete buttons and information must propagated to Critical Computer *)	


	(* T INLET *)

	TInlet_Avg 			:= 0.0;
	TInlet_Avg_Nb_Of_Probe	:= 0.0;

	CASE 	ANY_TO_DINT ( T_T1_PROBE_BINDING_SOURCE ) OF
		BINDING_DACN1_POWERDNA_IOMGR_T:
			
			FOR i:= 1 TO T_T1_NUMBER_PROBE  BY 1 DO
				IF (DACN1_POWERDNA_IOMGR_T[ T_T1_PROBE_INDEX[i] ].Out_Of_Service = FALSE ) THEN
					IF (DACN1_POWERDNA_IOMGR_T[ T_T1_PROBE_INDEX[i] ].Mean_Value < 3000.0 And 
					    DACN1_POWERDNA_IOMGR_T[ T_T1_PROBE_INDEX[i] ].Mean_Value > -460.0) THEN (* Validate if the reading is OK *)

						TInlet_Avg := TInlet_Avg  + (DACN1_POWERDNA_IOMGR_T[ T_T1_PROBE_INDEX[i] ].Mean_Value);
						TInlet_Avg_Nb_Of_Probe := TInlet_Avg_Nb_Of_Probe + 1.0;

					END_IF;
				END_IF;
			END_FOR;

		BINDING_DACN1_NIDAQ_IOMGR_VIN:

			FOR i:= 1 TO T_T1_NUMBER_PROBE  BY 1 DO
				IF (DACN1_NIDAQ_IOMGR_VIN[ T_T1_PROBE_INDEX[i] ].Out_Of_Service = FALSE ) THEN
					IF (DACN1_NIDAQ_IOMGR_VIN[ T_T1_PROBE_INDEX[i] ].Mean_Value < 3000.0 And 
					    DACN1_NIDAQ_IOMGR_VIN[ T_T1_PROBE_INDEX[i] ].Mean_Value > -460.0) THEN (* Validate if the reading is OK *)

						TInletP_Avg := TInletP_Avg  + (DACN1_NIDAQ_IOMGR_VIN[ T_T1_PROBE_INDEX[i] ].Mean_Value);
						TInletP_Avg_Nb_Of_Probe := TInletP_Avg_Nb_Of_Probe + 1.0;

					END_IF;
				END_IF;
			END_FOR;

		BINDING_DACN1_SERIAL_IOMGR_T:

			FOR i:= 1 TO T_T1_NUMBER_PROBE  BY 1 DO
				IF (DACN1_SERIAL_IOMGR_T[ T_T1_PROBE_INDEX[i] ].Out_Of_Service = FALSE ) THEN
					IF (DACN1_SERIAL_IOMGR_T[ T_T1_PROBE_INDEX[i] ].Mean_Value < 3000.0 And 
					    DACN1_SERIAL_IOMGR_T[ T_T1_PROBE_INDEX[i] ].Mean_Value > -460.0) THEN (* Validate if the reading is OK *)

						TInletP_Avg := TInletP_Avg  + (DACN1_SERIAL_IOMGR_T[ T_T1_PROBE_INDEX[i] ].Mean_Value);
						TInletP_Avg_Nb_Of_Probe := TInletP_Avg_Nb_Of_Probe + 1.0;

					END_IF;
				END_IF;
			END_FOR;

	ELSE
		err_code := -6;
		dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PT6A: T_T1_PROBE_BINDING_SOURCE NOT SUPPORTED');
		RETURN;
	
	END_CASE;         
	IF (TInlet_Avg_Nb_Of_Probe > 0.0 ) THEN
		TInlet_Avg	:= TInlet_Avg / TInlet_Avg_Nb_Of_Probe;
	END_IF;


	(* T EXHAUST *)

	TEgt_Avg 			:= 0.0;
	TEgt_Avg_Nb_Of_Probe	:= 0.0;

	CASE 	ANY_TO_DINT ( T_T7_PROBE_BINDING_SOURCE ) OF
		BINDING_DACN1_POWERDNA_IOMGR_T:
			
			FOR i:= 1 TO T_T7_NUMBER_PROBE  BY 1 DO
				IF (DACN1_POWERDNA_IOMGR_T[ T_T7_PROBE_INDEX[i] ].Out_Of_Service = FALSE ) THEN
					IF (DACN1_POWERDNA_IOMGR_T[ T_T7_PROBE_INDEX[i] ].Mean_Value < 3000.0 And 
					    DACN1_POWERDNA_IOMGR_T[ T_T7_PROBE_INDEX[i] ].Mean_Value > -460.0) THEN (* Validate if the reading is OK *)

						TEgt_Avg := TEgt_Avg  + (DACN1_POWERDNA_IOMGR_T[ T_T7_PROBE_INDEX[i] ].Mean_Value);
						TEgt_Avg_Nb_Of_Probe := TEgt_Avg_Nb_Of_Probe + 1.0;

					END_IF;
				END_IF;
			END_FOR;

		BINDING_DACN1_NIDAQ_IOMGR_VIN:
			
			FOR i:= 1 TO T_T7_NUMBER_PROBE  BY 1 DO
				IF (DACN1_NIDAQ_IOMGR_VIN[ T_T7_PROBE_INDEX[i] ].Out_Of_Service = FALSE ) THEN
					IF (DACN1_NIDAQ_IOMGR_VIN[ T_T7_PROBE_INDEX[i] ].Mean_Value < 3000.0 And 
					    DACN1_NIDAQ_IOMGR_VIN[ T_T7_PROBE_INDEX[i] ].Mean_Value > -460.0) THEN (* Validate if the reading is OK *)

						TEgt_Avg := TEgt_Avg  + (DACN1_NIDAQ_IOMGR_VIN[ T_T7_PROBE_INDEX[i] ].Mean_Value);
						TEgt_Avg_Nb_Of_Probe := TEgt_Avg_Nb_Of_Probe + 1.0;

					END_IF;
				END_IF;
			END_FOR;

		BINDING_DACN1_SERIAL_IOMGR_T:
			
			FOR i:= 1 TO T_T7_NUMBER_PROBE  BY 1 DO
				IF (DACN1_SERIAL_IOMGR_T[ T_T7_PROBE_INDEX[i] ].Out_Of_Service = FALSE ) THEN
					IF (DACN1_SERIAL_IOMGR_T[ T_T7_PROBE_INDEX[i] ].Mean_Value < 3000.0 And 
					    DACN1_SERIAL_IOMGR_T[ T_T7_PROBE_INDEX[i] ].Mean_Value > -460.0) THEN (* Validate if the reading is OK *)

						TEgtP_Avg := TEgtP_Avg  + (DACN1_SERIAL_IOMGR_T[ T_T7_PROBE_INDEX[i] ].Mean_Value);
						TEgtP_Avg_Nb_Of_Probe := TEgtP_Avg_Nb_Of_Probe + 1.0;

					END_IF;
				END_IF;
			END_FOR;

	ELSE
		err_code := -7;
		dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PT6A: T_T7_PROBE_BINDING_SOURCE NOT SUPPORTED');
		RETURN;
	
	END_CASE; 

	IF (TEgt_Avg_Nb_Of_Probe > 0.0 ) THEN
		TEgt_Avg	:= TEgt_Avg / TEgt_Avg_Nb_Of_Probe;
	END_IF;


	(* Specifics Trip Values for PT6A-61 BS618 are retrieved from TestSession*)
	UUT_Trip_T[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.T2;
	UUT_Trip_T[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.T3;
	

	(* Limits are based if ENGINE is in start / steady state : monitoring if NG has reached a speed equal or higher than Ground Idle (GI)*)
	CASE ANY_TO_DINT(UUT_Info.PwBuildSpecification) OF
		
		618 : (* Limit values for PT6A-61 depending on the BS618 *)
			
			IF (NG_Speed_RPM < NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = FALSE) THEN

				EGT_Limit := UUT_Trip_T[2].Trip_Point; (* Untrimmed Start Value from TestSession *)

			ELSIF (NG_Speed_RPM < NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = TRUE) THEN

				EGT_Limit := T5_TRIP_START_TRIMMED;

			ELSIF	(NG_Speed_RPM >= NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = FALSE) THEN

				EGT_Limit := UUT_Trip_T[3].Trip_Point; (* Untrimmed Steady-state Value from TestSession *)


			ELSIF	(NG_Speed_RPM >= NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = TRUE) THEN

				EGT_Limit := T5_TRIP_SS_TRIMMED;

			END_IF;

			UUT_Trip_T[1].Trip_Point	:=	EGT_Limit;(*fix bug pour PT6A-61 avec BS618 ou le trip point T1 etait toujours a 0 pcq test session le point T1 est 0 dans UUT_Trip *)

		ELSE   (* Limit values for other PT6A engines are retrieved from config file *)
			
						
			IF ( (UUT_Info.Model = 'PT6A-6') OR (UUT_Info.Model = 'PT6A-6A') OR (UUT_Info.Model = 'PT6A-6B') ) THEN
				
				(* Specific Limits for PT6A-6 Engines due to TT4 *)
				IF (NG_Speed_RPM < NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = FALSE) THEN

					UUT_Trip_T[1].Trip_Point	:=	T4_TRIP_START_UNTRIMMED;

				ELSIF (NG_Speed_RPM < NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = TRUE) THEN

					UUT_Trip_T[1].Trip_Point	:=	T4_TRIP_START_TRIMMED;

				ELSIF	(NG_Speed_RPM >= NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = FALSE) THEN

					UUT_Trip_T[1].Trip_Point	:=	T4_TRIP_SS_UNTRIMMED;

				ELSIF	(NG_Speed_RPM >= NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = TRUE) THEN

					UUT_Trip_T[1].Trip_Point	:=	T4_TRIP_SS_TRIMMED;

				END_IF;


			ELSE

				(* Limits for ALL other PT6A Engines *)
				IF (NG_Speed_RPM < NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = FALSE) THEN

					UUT_Trip_T[1].Trip_Point	:=	T5_TRIP_START_UNTRIMMED;

				ELSIF (NG_Speed_RPM < NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = TRUE) THEN

					UUT_Trip_T[1].Trip_Point	:=	T5_TRIP_START_TRIMMED;

				ELSIF	(NG_Speed_RPM >= NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = FALSE) THEN

					UUT_Trip_T[1].Trip_Point	:=	T5_TRIP_SS_UNTRIMMED;

				ELSIF	(NG_Speed_RPM >= NG_SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = TRUE) THEN

					UUT_Trip_T[1].Trip_Point	:=	T5_TRIP_SS_TRIMMED;

				END_IF;
			
			

			END_IF;
			
			EGT_Limit := UUT_Trip_T[1].Trip_Point; (* Dans tous les cas, on a un seul EGT_limit*)
			
	END_CASE;
	
	
	UUT_Trip_T[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.T4;

	UUT_Trip_F[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.F1;
	UUT_Trip_F[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.F2;
	UUT_Trip_F[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.F3;
	UUT_Trip_F[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.F4;

	UUT_Trip_N[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.N1;
	UUT_Trip_N[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.N2;
	UUT_Trip_N[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.N3;
	UUT_Trip_N[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.N4;

	UUT_Trip_P[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.P1;
	UUT_Trip_P[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.P2;
	UUT_Trip_P[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.P3;
	UUT_Trip_P[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.P4;

	(* Torque trip point is mutiplied by 0.491154 because Limit is in in.Hg but trip source is in psi (from powerDNA) *)
	UUT_Trip_Q[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q1 * 0.491154;
	UUT_Trip_Q[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q2;
	UUT_Trip_Q[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q3;
	UUT_Trip_Q[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q4;

	UUT_Trip_V[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.V1;
	UUT_Trip_V[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.V2;
	UUT_Trip_V[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.V3;
	UUT_Trip_V[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.V4;

	UUT_Trip_VIB[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB1;
	UUT_Trip_VIB[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB2;
	UUT_Trip_VIB[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB3;
	UUT_Trip_VIB[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB4;


	UUT_Trip_T[1].Trip_Source	:=	TExhaust;
(*	UUT_Trip_T[2].Trip_Source	:=	;*)
(*	UUT_Trip_T[3].Trip_Source	:=	;*)
(*	UUT_Trip_T[4].Trip_Source	:=	;*)


(*	UUT_Trip_F[1].Trip_Source	:=	;*)
(*	UUT_Trip_F[2].Trip_Source	:=	;*)
(*	UUT_Trip_F[3].Trip_Source	:=	;*)
(*	UUT_Trip_F[4].Trip_Source	:=	;*)

	UUT_Trip_N[1].Trip_Source	:=	NG_Speed_RPM;
	UUT_Trip_N[2].Trip_Source	:=	NF_Speed_RPM;
(*	UUT_Trip_N[3].Trip_Source	:=	;*)
	UUT_Trip_N[4].Trip_Source	:=	DynoSpeed_Source;

(*	UUT_Trip_P[1].Trip_Source	:=	;*)
(*	UUT_Trip_P[2].Trip_Source	:=	;*)
(*	UUT_Trip_P[3].Trip_Source	:=	;*)
(*	UUT_Trip_P[4].Trip_Source	:=	;*)

	UUT_Trip_Q[1].Trip_Source	:=	Torque_Source;
(*	UUT_Trip_Q[2].Trip_Source	:=	;*)
(*	UUT_Trip_Q[3].Trip_Source	:=	;*)
(*	UUT_Trip_Q[4].Trip_Source	:=	;*)

(*	UUT_Trip_V[1].Trip_Source	:=	;*)
(*	UUT_Trip_V[2].Trip_Source	:=	;*)
(*	UUT_Trip_V[3].Trip_Source	:=	;*)
(*	UUT_Trip_V[4].Trip_Source	:=	;*)

(*	UUT_Trip_VIB[1].Trip_Source	:=	;*)
(*	UUT_Trip_VIB[2].Trip_Source	:=	;*)
(*	UUT_Trip_VIB[3].Trip_Source	:=	;*)
(*	UUT_Trip_VIB[4].Trip_Source	:=	;*)











































END_FUNCTION_BLOCK