		T_EGT_PROBE_INDEX[18] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX18', '0');
		T_EGT_PROBE_INDEX[19] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX19', '0');
		T_EGT_PROBE_INDEX[20] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX20', '0');
		T_EGT_PROBE_INDEX[21] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX21', '0');
		T_EGT_PROBE_INDEX[22] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX22', '0');
		T_EGT_PROBE_INDEX[23] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX23', '0');
		T_EGT_PROBE_INDEX[24] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX24', '0');
		T_EGT_PROBE_INDEX[25] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX25', '0');
		T_EGT_PROBE_INDEX[26] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX26', '0');
		T_EGT_PROBE_INDEX[27] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX27', '0');
		T_EGT_PROBE_INDEX[28] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX28', '0');
		T_EGT_PROBE_INDEX[29] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX29', '0');
		T_EGT_PROBE_INDEX[30] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX30', '0');
		T_EGT_PROBE_INDEX[31] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX31', '0');
		T_EGT_PROBE_INDEX[32] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX32', '0');
		T_EGT_PROBE_INDEX[33] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX33', '0');
		T_EGT_PROBE_INDEX[34] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX34', '0');
		T_EGT_PROBE_INDEX[35] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX35', '0');
		T_EGT_PROBE_INDEX[36] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW200.T_EGT_PROBE_INDEX36', '0');

		(* Index is loaded dynamically during parsing of UART csv *)
		(*T_MGT_UART_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.T_MGT_UART_INDEX', '0');*)

		MGT_TRIP_START_TRIMMED		:= ReadOneRealConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.MGT_TRIP_START_TRIMMED', '0');
		MGT_TRIP_START_UNTRIMMED	:= ReadOneRealConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.MGT_TRIP_START_UNTRIMMED', '0');
		MGT_TRIP_SS_TRIMMED		:= ReadOneRealConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.MGT_TRIP_SS_TRIMMED', '0');
		MGT_TRIP_SS_UNTRIMMED		:= ReadOneRealConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.MGT_TRIP_SS_UNTRIMMED', '0');

		NG_INDEX 				:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.NG_INDEX', '0');
		NG_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.NG_BINDING_SOURCE', '0'));
		NG_100_RPM 				:= ReadOneRealConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.NG_100_RPM_CONSTANT', '0');
		NG_100_FREQ 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.NG_100_FREQ_CONSTANT', '0');

		NPT_INDEX 				:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.NPT_INDEX', '0');
		NPT_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.NPT_BINDING_SOURCE', '0'));
		NPT_100_RPM 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.NPT_100_RPM_CONSTANT', '0');
		NPT_100_FREQ 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.NPT_100_FREQ_CONSTANT', '0');










END_FUNCTION_BLOCK
