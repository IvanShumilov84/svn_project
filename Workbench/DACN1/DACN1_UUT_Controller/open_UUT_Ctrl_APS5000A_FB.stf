FUNCTION_BLOCK open_UUT_Ctrl_APS5000A_FB
(************************************************************************************************************************************************
	Name :		open_UUT_Ctrl_TSCP700_FB									
														
************************************************************************************************************************************************)	

   	Prefix_String := 'ConfigurationSettings.APS5000A.';

	T_EGT_TRIP_TYPE	:=  ReadOneIntegerConfigItemST( Prefix_String + 'T_EGT_TRIP_TYPE' , '0');

	N1_BINDING_SOURCE := ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'N1_BINDING_SOURCE', '0'));
	N1_INDEX 		:= ReadOneIntegerConfigItemST( Prefix_String + 'N1_INDEX', '0');

	N1_100_RPM 		:= ReadOneRealConfigItemST( Prefix_String + 'N1_100_RPM_CONSTANT', '0');
	N1_100_FREQ 	:= ReadOneRealConfigItemST( Prefix_String + 'N1_100_FREQ_CONSTANT', '0');

	APU_RUN_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'APU_RUN_CMD_BINDING_SOURCE', '0'));
	APU_RUN_CMD_INDEX 		:= ReadOneIntegerConfigItemST( Prefix_String + 'APU_RUN_CMD_INDEX', '0');

	APU_START_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'APU_START_CMD_BINDING_SOURCE', '0'));
	APU_START_CMD_INDEX 		:= ReadOneIntegerConfigItemST( Prefix_String + 'APU_START_CMD_INDEX', '0');























END_FUNCTION_BLOCK
