FUNCTION_BLOCK open_UUT_Ctrl_PT6C_FB
(************************************************************************************************************************************************
	Name :		open_UUT_Ctrl_PT6C._FB									
														
************************************************************************************************************************************************)	


		(* SPEED *)

		NG_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.NG_INDEX', '0');
		NG_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PT6C.NG_BINDING_SOURCE', '0'));
		NG_100_RPM 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.PT6C.NG_100_RPM_CONSTANT', '0');
		NG_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PT6C.NG_100_FREQ_CONSTANT', '0');

		NPT_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.NPT_INDEX', '0');
		NPT_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PT6C.NPT_BINDING_SOURCE', '0'));
		NPT_100_RPM 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PT6C.NPT_100_RPM_CONSTANT', '0');
		NPT_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PT6C.NPT_100_FREQ_CONSTANT', '0');

		(* T_INLET *)
		T_INLET_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_BINDING_SOURCE', '0'));
		T_INLET_NUMBER_PROBE 		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_NUMBER_PROBE', '0');

		T_INLET_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX1', '0');
		T_INLET_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX2', '0');
		T_INLET_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX3', '0');
		T_INLET_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX4', '0');
		T_INLET_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX5', '0');
		T_INLET_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX6', '0');
		T_INLET_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX7', '0');
		T_INLET_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX8', '0');
		T_INLET_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX9', '0');
		T_INLET_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX10', '0');
		T_INLET_PROBE_INDEX[11] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX11', '0');
		T_INLET_PROBE_INDEX[12] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_INLET_PROBE_INDEX12', '0');

		(* T_EGT *)
		T_EGT_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_BINDING_SOURCE', '0'));
		T_EGT_NUMBER_PROBE   := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_NUMBER_PROBE', '0');

		T_EGT_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX1', '0');
		T_EGT_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX2', '0');
		T_EGT_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX3', '0');
		T_EGT_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX4', '0');
		T_EGT_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX5', '0');
		T_EGT_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX6', '0');
		T_EGT_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX7', '0');
		T_EGT_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX8', '0');
		T_EGT_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX9', '0');
		T_EGT_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX10', '0');
		T_EGT_PROBE_INDEX[11] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX11', '0');
		T_EGT_PROBE_INDEX[12] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX12', '0');
		T_EGT_PROBE_INDEX[13] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX13', '0');
		T_EGT_PROBE_INDEX[14] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX14', '0');
		T_EGT_PROBE_INDEX[15] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX15', '0');
		T_EGT_PROBE_INDEX[16] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_EGT_PROBE_INDEX16', '0');

		(* ITT ARINC INDEX *)

		T_T5_INDEX 				:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PT6C.T_T5_INDEX', '0');

		T5_TRIP_START_TRIMMED		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PT6C.T5_TRIP_START_TRIMMED', '0');
		T5_TRIP_START_UNTRIMMED		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PT6C.T5_TRIP_START_UNTRIMMED', '0');
		T5_TRIP_SS_TRIMMED		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PT6C.T5_TRIP_SS_TRIMMED', '0');
		T5_TRIP_SS_UNTRIMMED		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PT6C.T5_TRIP_SS_UNTRIMMED', '0');







END_FUNCTION_BLOCK
