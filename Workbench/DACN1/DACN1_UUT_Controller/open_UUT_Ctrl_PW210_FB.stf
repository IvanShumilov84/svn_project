FUNCTION_BLOCK open_UUT_Ctrl_PW210_FB
(************************************************************************************************************************************************
	Name :		open_UUT_Ctrl_PW210_FB									
														
************************************************************************************************************************************************)	


		(* T_INLET *)
		T_INLET_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PW210.T_INLET_PROBE_BINDING_SOURCE', '0'));
		T_INLET_NUMBER_PROBE 		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_INLET_NUMBER_PROBE', '0');

		T_INLET_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_INLET_PROBE_INDEX1', '0');
		T_INLET_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_INLET_PROBE_INDEX2', '0');
		T_INLET_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_INLET_PROBE_INDEX3', '0');
		T_INLET_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_INLET_PROBE_INDEX4', '0');
		T_INLET_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_INLET_PROBE_INDEX5', '0');
		T_INLET_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_INLET_PROBE_INDEX6', '0');
		T_INLET_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_INLET_PROBE_INDEX7', '0');
		T_INLET_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_INLET_PROBE_INDEX8', '0');

		(* T_EGT *)
		T_EGT_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_BINDING_SOURCE', '0'));
		T_EGT_NUMBER_PROBE   := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_NUMBER_PROBE', '0');

		T_EGT_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX1', '0');
		T_EGT_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX2', '0');
		T_EGT_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX3', '0');
		T_EGT_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX4', '0');
		T_EGT_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX5', '0');
		T_EGT_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX6', '0');
		T_EGT_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX7', '0');
		T_EGT_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX8', '0');
		T_EGT_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX9', '0');
		T_EGT_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX10', '0');
		T_EGT_PROBE_INDEX[11] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX11', '0');
		T_EGT_PROBE_INDEX[12] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX12', '0');
		T_EGT_PROBE_INDEX[13] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX13', '0');
		T_EGT_PROBE_INDEX[14] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX14', '0');
		T_EGT_PROBE_INDEX[15] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX15', '0');
		T_EGT_PROBE_INDEX[16] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX16', '0');
		T_EGT_PROBE_INDEX[17] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX17', '0');
		T_EGT_PROBE_INDEX[18] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX18', '0');
		T_EGT_PROBE_INDEX[19] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX19', '0');
		T_EGT_PROBE_INDEX[20] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX20', '0');
		T_EGT_PROBE_INDEX[21] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX21', '0');
		T_EGT_PROBE_INDEX[22] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX22', '0');
		T_EGT_PROBE_INDEX[23] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX23', '0');
		T_EGT_PROBE_INDEX[24] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX24', '0');
		T_EGT_PROBE_INDEX[25] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX25', '0');
		T_EGT_PROBE_INDEX[26] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX26', '0');
		T_EGT_PROBE_INDEX[27] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX27', '0');
		T_EGT_PROBE_INDEX[28] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX28', '0');
		T_EGT_PROBE_INDEX[29] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX29', '0');
		T_EGT_PROBE_INDEX[30] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX30', '0');
		T_EGT_PROBE_INDEX[31] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX31', '0');
		T_EGT_PROBE_INDEX[32] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX32', '0');
		T_EGT_PROBE_INDEX[33] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX33', '0');
		T_EGT_PROBE_INDEX[34] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX34', '0');
		T_EGT_PROBE_INDEX[35] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX35', '0');
		T_EGT_PROBE_INDEX[36] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210.T_EGT_PROBE_INDEX36', '0');

		(* SPEED *)

		IF (UUT_Info.Model = 'PW210A') THEN
		
			(* MGT UART INDEX *)

			T_MGT_ARINC_INDEX 	:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210A.T_MGT_ARINC_INDEX', '0');

			MGT_TRIP_START_TRIMMED  := ReadOneRealConfigItemST( 'ConfigurationSettings.PW210A.MGT_TRIP_START_TRIMMED', '0');
			MGT_TRIP_START_UNTRIMMED:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210A.MGT_TRIP_START_UNTRIMMED', '0');
			MGT_TRIP_SS_TRIMMED	:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210A.MGT_TRIP_SS_TRIMMED', '0');
			MGT_TRIP_SS_UNTRIMMED	:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210A.MGT_TRIP_SS_UNTRIMMED', '0');

			NG_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210A.NG_INDEX', '0');
			NG_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PW210A.NG_BINDING_SOURCE', '0'));
			NG_100_RPM 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210A.NG_100_RPM_CONSTANT', '0');
			NG_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210A.NG_100_FREQ_CONSTANT', '0');

			NPT_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210A.NPT_INDEX', '0');
			NPT_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PW210A.NPT_BINDING_SOURCE', '0'));
			NPT_100_RPM 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210A.NPT_100_RPM_CONSTANT', '0');
			NPT_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210A.NPT_100_FREQ_CONSTANT', '0');
			
		ELSIF (UUT_Info.Model = 'PW210E') THEN

			(* MGT UART INDEX *)

			T_MGT_ARINC_INDEX 	:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210E.T_MGT_ARINC_INDEX', '0');
			
			MGT_TRIP_START_TRIMMED  := ReadOneRealConfigItemST( 'ConfigurationSettings.PW210E.MGT_TRIP_START_TRIMMED', '0');
			MGT_TRIP_START_UNTRIMMED:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210E.MGT_TRIP_START_UNTRIMMED', '0');
			MGT_TRIP_SS_TRIMMED	:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210E.MGT_TRIP_SS_TRIMMED', '0');
			MGT_TRIP_SS_UNTRIMMED	:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210E.MGT_TRIP_SS_UNTRIMMED', '0');

			NG_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210E.NG_INDEX', '0');
			NG_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PW210E.NG_BINDING_SOURCE', '0'));
			NG_100_RPM 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210E.NG_100_RPM_CONSTANT', '0');
			NG_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210E.NG_100_FREQ_CONSTANT', '0');

			NPT_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210E.NPT_INDEX', '0');
			NPT_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PW210E.NPT_BINDING_SOURCE', '0'));
			NPT_100_RPM 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210E.NPT_100_RPM_CONSTANT', '0');
			NPT_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210E.NPT_100_FREQ_CONSTANT', '0');

		ELSIF (UUT_Info.Model = 'PW210S') THEN

			(* MGT UART INDEX *)

			T_MGT_ARINC_INDEX 	:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210S.T_MGT_ARINC_INDEX', '0');

			MGT_TRIP_START_TRIMMED  := ReadOneRealConfigItemST( 'ConfigurationSettings.PW210S.MGT_TRIP_START_TRIMMED', '0');
			MGT_TRIP_START_UNTRIMMED:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210S.MGT_TRIP_START_UNTRIMMED', '0');
			MGT_TRIP_SS_TRIMMED	:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210S.MGT_TRIP_SS_TRIMMED', '0');
			MGT_TRIP_SS_UNTRIMMED	:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210S.MGT_TRIP_SS_UNTRIMMED', '0');

			NG_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210S.NG_INDEX', '0');
			NG_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PW210S.NG_BINDING_SOURCE', '0'));
			NG_100_RPM 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210S.NG_100_RPM_CONSTANT', '0');
			NG_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210S.NG_100_FREQ_CONSTANT', '0');

			NPT_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.PW210S.NPT_INDEX', '0');
			NPT_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.PW210S.NPT_BINDING_SOURCE', '0'));
			NPT_100_RPM 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210S.NPT_100_RPM_CONSTANT', '0');
			NPT_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.PW210S.NPT_100_FREQ_CONSTANT', '0');
	
		END_IF;









END_FUNCTION_BLOCK
