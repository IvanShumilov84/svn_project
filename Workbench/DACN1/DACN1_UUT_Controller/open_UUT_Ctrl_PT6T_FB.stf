FUNCTION_BLOCK open_UUT_Ctrl_PT6T_FB
(************************************************************************************************************************************************
	Name :		open_UUT_Ctrl_PT6A._FB									
														
	Description :	Code for importing Speed,INLET, EGT and InterTurbine static Data to the Workbench at Opening.
    

	Dependacy : 	

					HISTORY
	Rev			Date			Name			Description
		     		(YYYY/MM/DD)

	1.0	         	2015/09/ 		?.....		First Release
	2.0	         	2015/09/23		A. Armand		Added :  Engine Model handling, and Probes number for Project 14086
	2.1			2015/11/13		A.Armand		Added : TT4 TRIP for PT6A-6 Engines
	
************************************************************************************************************************************************)	


		
		(* Parameters are retrieved from XML(.cfg) file by engine model *)
		Prefix_String := 'ConfigurationSettings.' + UUT_INFO.Model + '.';


		(* SPEED *)
		(* NGT values are the same, but INDEX are different in the config file of this project*)
		NGP_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'NGP_INDEX', '0');
		NGP_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'NGP_BINDING_SOURCE', '0'));
		NGS_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'NGS_INDEX', '0');
		NGS_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'NGS_BINDING_SOURCE', '0'));
		NG_100_RPM 				:= ReadOneRealConfigItemST( Prefix_String + 'NG_100_RPM_CONSTANT', '0');
		NG_100_FREQ 			:= ReadOneRealConfigItemST( Prefix_String + 'NG_100_FREQ_CONSTANT', '0');

		NFP_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'NFP_INDEX', '0');
		NFP_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'NFP_BINDING_SOURCE', '0'));
		NFS_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'NFS_INDEX', '0');
		NFS_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'NFS_BINDING_SOURCE', '0'));
		NF_100_RPM 				:= ReadOneRealConfigItemST( Prefix_String + 'NF_100_RPM_CONSTANT', '0');
		NF_100_FREQ 			:= ReadOneRealConfigItemST( Prefix_String + 'NF_100_FREQ_CONSTANT', '0');

		T_T5P_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T5P_PROBE_BINDING_SOURCE', '0'));
		T_T5P_INDEX 			:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T5P_INDEX', '0');
		
		T_T5S_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T5S_PROBE_BINDING_SOURCE', '0'));
		T_T5S_INDEX 			:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T5S_INDEX', '0');


		IF ((UUT_Info.Model = 'PT6T-3') AND (UUT_Info.UUT_Choices[2] = 'PST-SB5126/SB5178')) THEN

			T5_TRIP_START_TRIMMED	:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_START_TRIMMED_ALTERNATE', '0');
			T5_TRIP_START_UNTRIMMED	:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_START_UNTRIMMED_ALTERNATE', '0');
			T5_TRIP_SS_TRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_SS_TRIMMED_ALTERNATE', '0');
			T5_TRIP_SS_UNTRIMMED	:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_SS_UNTRIMMED_ALTERNATE', '0');

		ELSE

			T5_TRIP_START_TRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_START_TRIMMED', '0');
			T5_TRIP_START_UNTRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_START_UNTRIMMED', '0');
			T5_TRIP_SS_TRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_SS_TRIMMED', '0');
			T5_TRIP_SS_UNTRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_SS_UNTRIMMED', '0');

		END_IF;

		IF ((UUT_Info.Model = 'PT6T-6_SIKOR') OR (UUT_Info.Model = 'PT6T-6_BELL')) THEN

			T7_TRIP_START_TRIMMED 		:= ReadOneRealConfigItemST( Prefix_String + 'T7_TRIP_START_TRIMMED', '0');
			T7_TRIP_START_UNTRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T7_TRIP_START_UNTRIMMED', '0');
			T7_TRIP_SS_TRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T7_TRIP_SS_TRIMMED', '0');
			T7_TRIP_SS_UNTRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T7_TRIP_SS_UNTRIMMED', '0');

		END_IF;


		TORQUEP_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'TORQUEP_INDEX', '0');
		TORQUEP_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'TORQUEP_BINDING_SOURCE', '0'));

		TORQUES_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'TORQUES_INDEX', '0');
		TORQUES_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'TORQUES_BINDING_SOURCE', '0'));

		(* T_INLET  *)
		
		T_T1_NUMBER_PROBE 		:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T1_NUMBER_PROBE', '0');

		T_T1P_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T1P_PROBE_BINDING_SOURCE', '0'));

		FOR i:=1 TO T_T1_NUMBER_PROBE BY 1 DO
			
			T_T1P_PROBE_INDEX[i] 	:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T1P_PROBE_INDEX' + ANY_TO_STRING(i), '0');

		END_FOR;

		T_T1S_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T1S_PROBE_BINDING_SOURCE', '0'));

		FOR i:=1 TO T_T1_NUMBER_PROBE BY 1 DO
			
			T_T1S_PROBE_INDEX[i] 	:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T1S_PROBE_INDEX' + ANY_TO_STRING(i), '0');

		END_FOR;

			
		(* T_EGT *)

		T_T7_NUMBER_PROBE   		:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T7_NUMBER_PROBE', '0');

		T_T7P_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T7P_PROBE_BINDING_SOURCE', '0'));

		FOR i:=1 TO T_T7_NUMBER_PROBE BY 1 DO
			
			T_T7P_PROBE_INDEX[i] 	:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T7P_PROBE_INDEX' + ANY_TO_STRING(i), '0');

		END_FOR;

		T_T7S_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T7S_PROBE_BINDING_SOURCE', '0'));

		FOR i:=1 TO T_T7_NUMBER_PROBE BY 1 DO
			
			T_T7S_PROBE_INDEX[i] 	:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T7S_PROBE_INDEX' + ANY_TO_STRING(i), '0');

		END_FOR;























END_FUNCTION_BLOCK