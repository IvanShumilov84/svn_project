FUNCTION_BLOCK open_UUT_Ctrl_APS500_FB
(************************************************************************************************************************************************
	Name :		open_UUT_Ctrl_APS500_FB									
														
************************************************************************************************************************************************)	


IF (UUT_Info.Family = 'APS500')  THEN

	ETC_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_BINDING_SOURCE', '0'));

	ETC_NUMBER_PROBE := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_NUMBER_PROBE', '1');

	ETC_ENGINE_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX1', '0');
	ETC_ENGINE_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX2', '0');
	ETC_ENGINE_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX3', '0');
	ETC_ENGINE_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX4', '0');
	ETC_ENGINE_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX5', '0');
	ETC_ENGINE_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX6', '0');
	ETC_ENGINE_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX7', '0');
	ETC_ENGINE_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX8', '0');
	ETC_ENGINE_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX9', '0');
	ETC_ENGINE_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ETC_PROBE_INDEX10', '0');
	
	N1_95_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS500.N1_95_BINDING_SOURCE', '0'));
	N1_95_INDEX := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.N1_95_INDEX', '0');

	N1_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS500.N1_BINDING_SOURCE', '0'));

	N1_100_RPM := ReadOneRealConfigItemST( 'ConfigurationSettings.APS500.N1_100_RPM_CONSTANT', '0');

	OVERTEMP_DISABLE_BINDING_SOURCE := ConvertBindingSourceStringToDint( ReadOneStringConfigItemST( 'ConfigurationSettings.APS500.OVERTEMP_DISABLE_BINDING_SOURCE', '0'));
	OVERTEMP_DISABLE_INDEX := ReadOneIntegerConfigItemST('ConfigurationSettings.APS500.OVERTEMP_DISABLE_INDEX', '0');

	(* ECB_POWER_CMD *)
	ECB_POWER_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS500.ECB_POWER_CMD_BINDING_SOURCE', '0'));
	ECB_POWER_CMD_INDEX		:=  ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500.ECB_POWER_CMD_INDEX', '0');

END_IF;

IF (UUT_Info.Model = 'APS500-C7B') THEN

	EGT_TRIP_START := ReadOneRealConfigItemST( 'ConfigurationSettings.APS500-C7B.EGT_TRIP_START', '0');
	EGT_TRIP_STEADY:= ReadOneRealConfigItemST( 'ConfigurationSettings.APS500-C7B.EGT_TRIP_STEADY', '0');
	N1_INDEX := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500-C7B.N1_INDEX', '0');
	N1_100_FREQ := ReadOneRealConfigItemST( 'ConfigurationSettings.APS500-C7B.N1_100_FREQ_CONSTANT', '0');

ELSIF (UUT_Info.Model = 'APS500-C7D') THEN

	EGT_TRIP_START := ReadOneRealConfigItemST( 'ConfigurationSettings.APS500-C7D.EGT_TRIP_START', '0');
	EGT_TRIP_STEADY:= ReadOneRealConfigItemST( 'ConfigurationSettings.APS500-C7D.EGT_TRIP_STEADY', '0');
	N1_INDEX := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500-C7D.N1_INDEX', '0');
	N1_100_FREQ := ReadOneRealConfigItemST( 'ConfigurationSettings.APS500-C7D.N1_100_FREQ_CONSTANT', '0');

ELSIF (UUT_Info.Model = 'APS500-C11') THEN

	EGT_TRIP_START := ReadOneRealConfigItemST( 'ConfigurationSettings.APS500-C11.EGT_TRIP_START', '0');
	EGT_TRIP_STEADY:= ReadOneRealConfigItemST( 'ConfigurationSettings.APS500-C11.EGT_TRIP_STEADY', '0');
	N1_INDEX := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS500-C11.N1_INDEX', '0');
	N1_100_FREQ := ReadOneRealConfigItemST( 'ConfigurationSettings.APS500-C11.N1_100_FREQ_CONSTANT', '0');

END_IF;
















END_FUNCTION_BLOCK
