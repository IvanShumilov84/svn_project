FUNCTION_BLOCK open_UUT_Ctrl_GTCP331_500_FB
	
	IF (err_code <> OK) THEN 
		status	:= ERROR_ON_OPENING;
		dummy	:= LOG_MSG('ErrLog', 'DACN1_UUT_CRUNCHER: ERROR ON OPENING');		
	ELSIF (UUT_Info.Model = 'GTCP331-500B') THEN


		(* SPEED *)
		NG_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.NG_BINDING_SOURCE', '0'));
		NG_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.NG_INDEX', '0');
		NG_100_RPM 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.GTCP331-500B.NG_100_RPM_CONSTANT', '0');
		NG_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.GTCP331-500B.NG_100_FREQ_CONSTANT', '0');

		
		T_EGT_TRIP_TYPE	:=  ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_TRIP_TYPE' , '0');


		(* T_EGT_P *)
		T_EGT_P_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_P_PROBE_BINDING_SOURCE', '0'));
		T_EGT_P_ENGINE_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_P_PROBE_INDEX1', '0');
		T_EGT_P_ENGINE_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_P_PROBE_INDEX2', '0');


		(* T_EGT *)
		T_EGT_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_BINDING_SOURCE', '0'));
		T_EGT_NUMBER_PROBE   := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_NUMBER_PROBE', '0');
		T_EGT_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX1', '0');
		T_EGT_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX2', '0');
		T_EGT_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX3', '0');
		T_EGT_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX4', '0');
		T_EGT_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX5', '0');
		T_EGT_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX6', '0');
		T_EGT_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX7', '0');
		T_EGT_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX8', '0');
		T_EGT_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX9', '0');
		T_EGT_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX10', '0');
		T_EGT_PROBE_INDEX[11] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX11', '0');
		T_EGT_PROBE_INDEX[12] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX12', '0');
		T_EGT_PROBE_INDEX[13] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX13', '0');
		T_EGT_PROBE_INDEX[14] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX14', '0');
		T_EGT_PROBE_INDEX[15] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_EGT_PROBE_INDEX15', '0');


		
		(* T_INLET *)
		T_INLET_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_BINDING_SOURCE', '0'));
		T_INLET_NUMBER_PROBE 		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_NUMBER_PROBE', '0');

		T_INLET_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX1', '0');
		T_INLET_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX2', '0');
		T_INLET_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX3', '0');
		T_INLET_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX4', '0');
		T_INLET_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX5', '0');
		T_INLET_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX6', '0');
		T_INLET_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX7', '0');
		T_INLET_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX8', '0');
		T_INLET_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX9', '0');
		T_INLET_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_INLET_PROBE_INDEX10', '0');

	
		(* T_OIL *)
		T_OIL_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_OIL_PROBE_BINDING_SOURCE', '0'));
		T_OIL_PROBE_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.T_OIL_PROBE_INDEX', '0');


		(* P_OIL *)
		P_OIL_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.P_OIL_PROBE_BINDING_SOURCE', '0'));
		P_OIL_PROBE_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.P_OIL_PROBE_INDEX', '0');


		(* RTL_ELECTRICAL *)
		RTL_ELECTRICAL_DIN_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.RTL_ELECTRICAL_DIN_BINDING_SOURCE', '0'));
		RTL_ELECTRICAL_DIN_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.RTL_ELECTRICAL_DIN_INDEX', '0');
		
		(* RTL_PNEUMATIC *)
		RTL_PNEUMATIC_DIN_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.RTL_PNEUMATIC_DIN_BINDING_SOURCE', '0'));
		RTL_PNEUMATIC_DIN_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.RTL_PNEUMATIC_DIN_INDEX', '0');


		(* APU_FIRE_CMD/E_STOP_ECB *)
		APU_FIRE_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.APU_FIRE_CMD_BINDING_SOURCE', '0'));
		APU_FIRE_CMD_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.APU_FIRE_CMD_INDEX', '0');

		(* E_STOP_DAS FROM FACILITY XML SECTION *)
		E_STOP_DAS_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.FACILITY.E_STOP_DAS_CMD_BINDING_SOURCE', '0'));
		E_STOP_DAS_CMD_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.FACILITY.E_STOP_DAS_CMD_INDEX', '0');

		(* APU_FAULT *)
		APU_FAULT_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.APU_FAULT_BINDING_SOURCE', '0'));
		APU_FAULT_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.APU_FAULT_INDEX', '0');

		(* VIB_TURBINE *)
		VIB_TURBINE_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.VIB_TURBINE_BINDING_SOURCE', '0'));
		VIB_TURBINE_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.VIB_TURBINE_INDEX', '0');

		(* VIB_GEARBOX *)
		VIB_GEARBOX_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.VIB_GEARBOX_BINDING_SOURCE', '0'));
		VIB_GEARBOX_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.VIB_GEARBOX_INDEX', '0');

		(* APU_RUN_STOP_CMD *)
		APU_RUN_STOP_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.APU_RUN_STOP_CMD_BINDING_SOURCE', '0'));
		APU_RUN_STOP_CMD_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.APU_RUN_STOP_CMD_INDEX', '0');

		(* START_RELAY_IND *)
		START_RELAY_IND_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.START_RELAY_IND_BINDING_SOURCE', '0'));
		START_RELAY_IND_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.START_RELAY_IND_INDEX', '0');


		(* DC_STARTER_ENGAGED_IND *)
		DC_STARTER_ENGAGED_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.DC_STARTER_ENGAGED_BINDING_SOURCE', '0'));
		DC_STARTER_ENGAGED_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.DC_STARTER_ENGAGED_INDEX', '0');

		(* AIR_START_SELECTION *)
		AIR_STARTER_SELECTION_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.GTCP331-500B.AIR_STARTER_SELECTION_BINDING_SOURCE', '0'));
		AIR_STARTER_SELECTION_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.GTCP331-500B.AIR_STARTER_SELECTION_INDEX', '0');

	

		(* Reinit variables *)
           	Accel_Init := FALSE;
		AccelerationTime_Value		:= 0.0;
		StarterCutoutTime_Value 	:= 0.0;
		AirAccelerationTime_Value 	:= 0.0;
		AirStarterCutoutTime_Value 	:= 0.0;
		DCAccelerationTime_Value 	:= 0.0;
		DCStarterCutoutTime_Value 	:= 0.0;
		TEgt_P_Avg_Max          	:= 0.0;
        	TEgt_Avg_Max            	:= 0.0;
		VibGearboxMax_Value     	:= 0.0;
		VibTurbineMax_Value     	:= 0.0;
		VibCoolingMax_Value     	:= 0.0;
		POilMax_Value           	:= 0.0;
		NG_Speed_Max_Value 		:= 0.0;
		TEgt_PeakStart_DEGF_Value 	:= 0.0;
		TEtc_PeakStart_DEGF_Value 	:= 0.0;


		
		Start_Acceleration_Latch(FALSE,TRUE); (*Reset Latch*)
		Acceleration_Timer(FALSE, t#300s);    (*Reset Timer*)

		TIME_RUN := 0.0;
		TIME_RUN_Latch(FALSE,TRUE);	(*Reset Latch*)
		TIME_RUN_Timer(FALSE, t#8h);	(*Reset Timer*)

		TIME_RUN_DOWN := 0.0;
		TIME_RUN_DOWN_Latch(FALSE,TRUE);	(*Reset Latch*)
		TIME_RUN_DOWN_Timer(FALSE, t#8h);	(*Reset Timer*)

		ET_CRANK := 0.0;
		ET_CRANK_Latch(FALSE,TRUE);	(*Reset Latch*)
		ET_CRANK_Timer(FALSE, t#300s);	(*Reset Timer*)


		ET_100 := 0.0;
		ET_100_Latch(FALSE,TRUE);	(*Reset Latch*)
		ET_100_Timer(FALSE, t#300s);	(*Reset Timer*)

	END_IF;





END_FUNCTION_BLOCK
