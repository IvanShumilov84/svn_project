FUNCTION_BLOCK open_UUT_Ctrl_APS32X0_FB

	IF (err_code <> OK) THEN 
		status	:= ERROR_ON_OPENING;
		dummy	:= LOG_MSG('ErrLog', 'open_UUT_Ctrl_APS32X0_FB: ERROR ON OPENING');		
	ELSE


		(* SPEED *)
		NG_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.NG_BINDING_SOURCE', '0'));
		NG_INDEX 			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.NG_INDEX', '0');
		NG_100_RPM 			:= ReadOneRealConfigItemST( 'ConfigurationSettings.APS32X0.NG_100_RPM_CONSTANT', '0');
		NG_100_FREQ 		:= ReadOneRealConfigItemST( 'ConfigurationSettings.APS32X0.NG_100_FREQ_CONSTANT', '0');


		T_EGT_TRIP_TYPE	:=  ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_TRIP_TYPE' , '0');


		(* T_EGT_P *)
		T_EGT_P_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_P_PROBE_BINDING_SOURCE', '0'));
		T_EGT_P_ENGINE_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_P_PROBE_INDEX1', '0');
		T_EGT_P_ENGINE_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_P_PROBE_INDEX2', '0');


		(* T_EGT *)
		(* There are either 6 or 12 EGT probes depending on the tooling used for the project *)
		(* Hamilton tooling has 6 probes and Honeywell tooling has 12 *)
		T_EGT_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_BINDING_SOURCE', '0'));
		T_EGT_NUMBER_PROBE   := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_NUMBER_PROBE', '0');
		T_EGT_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX1', '0');
		T_EGT_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX2', '0');
		T_EGT_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX3', '0');
		T_EGT_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX4', '0');
		T_EGT_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX5', '0');
		T_EGT_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX6', '0');
		IF (T_EGT_NUMBER_PROBE > 6) THEN
			T_EGT_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX7', '0');
			T_EGT_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX8', '0');
			T_EGT_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX9', '0');
			T_EGT_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX10', '0');
			T_EGT_PROBE_INDEX[11] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX11', '0');
			T_EGT_PROBE_INDEX[12] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_EGT_PROBE_INDEX12', '0');
		END_IF;

		(* T_INLET *)
		T_INLET_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_BINDING_SOURCE', '0'));
		T_INLET_NUMBER_PROBE 		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_NUMBER_PROBE', '0');

		T_INLET_PROBE_INDEX[1] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX1', '0');
		T_INLET_PROBE_INDEX[2] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX2', '0');
		T_INLET_PROBE_INDEX[3] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX3', '0');
		T_INLET_PROBE_INDEX[4] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX4', '0');
		T_INLET_PROBE_INDEX[5] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX5', '0');
		T_INLET_PROBE_INDEX[6] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX6', '0');
		T_INLET_PROBE_INDEX[7] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX7', '0');
		T_INLET_PROBE_INDEX[8] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX8', '0');
		T_INLET_PROBE_INDEX[9] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX9', '0');
		T_INLET_PROBE_INDEX[10] := ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_INLET_PROBE_INDEX10', '0');

	
		(* T_OIL *)
		T_OIL_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.T_OIL_PROBE_BINDING_SOURCE', '0'));
		T_OIL_PROBE_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.T_OIL_PROBE_INDEX', '0');


		(* P_OIL *)
		P_OIL_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.P_OIL_PROBE_BINDING_SOURCE', '0'));
		P_OIL_PROBE_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.P_OIL_PROBE_INDEX', '0');


		(* RTL_ELECTRICAL *)
		RTL_ELECTRICAL_DIN_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.RTL_ELECTRICAL_DIN_BINDING_SOURCE', '0'));
		RTL_ELECTRICAL_DIN_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.RTL_ELECTRICAL_DIN_INDEX', '0');

		(* E_STOP_ECB *)
		E_STOP_ECB_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.E_STOP_ECB_CMD_BINDING_SOURCE', '0'));
		E_STOP_ECB_CMD_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.E_STOP_ECB_CMD_INDEX', '0');

		(* E_STOP_DAS FROM FACILITY XML SECTION *)
		E_STOP_DAS_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.FACILITY.E_STOP_DAS_CMD_BINDING_SOURCE', '0'));
		E_STOP_DAS_CMD_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.FACILITY.E_STOP_DAS_CMD_INDEX', '0');

		(* APU_FAULT *)
		APU_FAULT_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.APU_FAULT_BINDING_SOURCE', '0'));
		APU_FAULT_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.APU_FAULT_INDEX', '0');

		(* VIB_TURBINE *)
		VIB_TURBINE_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.VIB_TURBINE_BINDING_SOURCE', '0'));
		VIB_TURBINE_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.VIB_TURBINE_INDEX', '0');

		(* VIB_GEARBOX *)
		VIB_GEARBOX_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.VIB_GEARBOX_BINDING_SOURCE', '0'));
		VIB_GEARBOX_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.VIB_GEARBOX_INDEX', '0');

		(* VIB_COOLING *)
		VIB_COOLING_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.VIB_COOLING_BINDING_SOURCE', '0'));
		VIB_COOLING_INDEX			:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.' + UUT_INFO.Model + '.VIB_COOLING_INDEX', '0');

		(* APU_STOP_CMD *)
		APU_STOP_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.APU_STOP_CMD_BINDING_SOURCE', '0'));
		APU_STOP_CMD_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.APU_STOP_CMD_INDEX', '0');

		(* STARTER_ENGAGED_IND *)
		STARTER_ENGAGED_IND_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.STARTER_ENGAGED_IND_BINDING_SOURCE', '0'));
		STARTER_ENGAGED_IND_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.STARTER_ENGAGED_IND_INDEX', '0');

		(* ECB_POWER_CMD *)
		ECB_POWER_CMD_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.ECB_POWER_CMD_BINDING_SOURCE', '0'));
		ECB_POWER_CMD_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.ECB_POWER_CMD_INDEX', '0');


		(* FUEL_VALVE_IND *)
		FUEL_VALVE_IND_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.FUEL_VALVE_IND_BINDING_SOURCE', '0'));
		FUEL_VALVE_IND_INDEX		:= ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.FUEL_VALVE_IND_INDEX', '0');


		(* START_IN_PROGRESS_IND *)
		START_IN_PROGRESS_IND_BINDING_SOURCE	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( 'ConfigurationSettings.APS32X0.START_IN_PROGRESS_IND_BINDING_SOURCE', '0'));
		START_IN_PROGRESS_IND_INDEX			:=  ReadOneIntegerConfigItemST( 'ConfigurationSettings.APS32X0.START_IN_PROGRESS_IND_INDEX', '0');


		(* Reinit variables *)
           	Accel_Init := FALSE;
		AccelerationTime_Value	:= 0.0;
		StarterCutoutTime_Value := 0.0;
		TEgt_P_Avg_Max          := 0.0;
        	TEgt_Avg_Max            := 0.0;
		VibGearboxMax_Value     := 0.0;
		VibTurbineMax_Value     := 0.0;
		VibCoolingMax_Value     := 0.0;
		POilMax_Value           := 0.0;
		NG_Speed_Max_Value 	:= 0.0;

		
		Start_Acceleration_Latch(FALSE,TRUE); (*Reset Latch*)
		Acceleration_Timer(FALSE, t#300s);    (*Reset Timer*)

		TIME_RUN := 0.0;
		TIME_RUN_Latch(FALSE,TRUE);	(*Reset Latch*)
		TIME_RUN_Timer(FALSE, t#8h);	(*Reset Timer*)

		TIME_RUN_DOWN := 0.0;
		TIME_RUN_DOWN_Latch(FALSE,TRUE);	(*Reset Latch*)
		TIME_RUN_DOWN_Timer(FALSE, t#8h);	(*Reset Timer*)

		ET_CRANK := 0.0;
		ET_CRANK_Latch(FALSE,TRUE);	(*Reset Latch*)
		ET_CRANK_Timer(FALSE, t#300s);	(*Reset Timer*)


		ET_100 := 0.0;
		ET_100_Latch(FALSE,TRUE);	(*Reset Latch*)
		ET_100_Timer(FALSE, t#300s);	(*Reset Timer*)

		ET_SIP := 0.0;
		ET_SIP_Latch(FALSE,TRUE);	(*Reset Latch*)
		ET_SIP_Timer(FALSE, t#300s);	(*Reset Timer*)


	END_IF;

















END_FUNCTION_BLOCK