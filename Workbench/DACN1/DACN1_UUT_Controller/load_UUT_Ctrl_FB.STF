FUNCTION_BLOCK LOAD_UUT_CTRL_FB
(************************************************************************************************************************************************
	Name :		load_UUT_Ctrl_FB									
														
	Description :	   

	Dependacy : 	

					HYSTORY
	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         				First Release

************************************************************************************************************************************************)	

	status 		:= LOADING;
	dummy		:= LOG_MSG('ErrLog', 'DACN1_UUT_CONTROLLER: LOADING');
	err_code 	:= OK;

	IF (err_code <> OK) THEN 
		status 	:= ERROR_ON_LOADING;
		dummy	:= LOG_MSG('ErrLog', 'DACN1_UUT_CONTROLLER: ERROR ON LOADING');
	ELSE 
		status 	:= LOADED;
		dummy	:= LOG_MSG('ErrLog', 'DACN1_UUT_CONTROLLER: LOADED');
	END_IF; 	



END_FUNCTION_BLOCK
