FUNCTION_BLOCK run_UUT_Ctrl_PW210_FB
(************************************************************************************************************************************************
	Name :		run_UUT_Ctrl_PW210_FB									
														
************************************************************************************************************************************************)	

	status 		:= RUNNING;
	(*dummy		:= LOG_MSG('ErrLog', 'DACN1_UUT_CONTROLLER: RUNNING');*)
	err_code 	:= OK;

	(*PW210A						*)
	(*51000 RPM : 5.6941 Frequency Factor	*)
	(*26342 RPM : 9.1469 Frequency Factor	*)
	(*PW210E						*)
	(*51000 RPM : 6.0011 Frequency Factor	*)
	(*26010 RPM : 16.379 Frequency Factor	*)
	(*PW210S						*)
	(*58000 RPM : 6.0803 Frequency Factor	*)
	(*26838 RPM : 3171.3 Frequency Factor	*)
	(* Limits is expressed in % *)

	(* NG *)
	CASE 	ANY_TO_DINT ( NG_BINDING_SOURCE ) OF

		BINDING_DACN1_NIDAQ_IOMGR_F:
			NG_HZ	:=DACN1_NIDAQ_IOMGR_F[ NG_INDEX ].Mean_Value; 		
	ELSE
		err_code := -2;
		dummy		:= LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PW210: NG_BINDING_SOURCE NOT SUPPORTED');
		RETURN;

	END_CASE;   
      
	NG_Speed_RPM	:= (NG_HZ * NG_100_RPM) / NG_100_FREQ;
	NG_Speed_PCT	:= (NG_HZ / NG_100_FREQ ) * 100.0;

	(* NPT *)
	CASE 	ANY_TO_DINT ( NPT_BINDING_SOURCE ) OF

		BINDING_DACN1_NIDAQ_IOMGR_F:
			NPT_HZ :=DACN1_NIDAQ_IOMGR_F[ NPT_INDEX ].Mean_Value; 		
	ELSE
		err_code := -3;
		dummy		:= LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PW210: NPT_BINDING_SOURCE NOT SUPPORTED');
		RETURN;

	END_CASE;   
      
	NPT_Speed_RPM	:= (NPT_HZ * NPT_100_RPM) / NPT_100_FREQ;
	NPT_Speed_PCT	:= (NPT_HZ / NPT_100_FREQ ) * 100.0;


	(* TExhaust corresponds physically to MGT (Measured Gas Temperature, ARINC parameter, converted from degre C to F *)
	TExhaust		:= ((((DACN1_OMNIBUSBOX_IOMGR_A429IN_CHA[T_MGT_ARINC_INDEX].engUnit * 1.8) + 32.0) + ((DACN1_OMNIBUSBOX_IOMGR_A429IN_CHB[T_MGT_ARINC_INDEX].engUnit * 1.8) + 32.0)) / 2.0);
	Torque_Source	:= ANY_TO_REAL(Torquemeter_torque);
	DynoSpeed_Source	:= Dyno_Speed;


	(* TT1, TT7 We need to calculate an average on QNX as Performance Computer manage *)
	(* average with delete buttons and information must propagated to Critical Computer *)	


	(* T INLET *)

	TInlet_Avg 			:= 0.0;
	TInlet_Spread_Max		:= 0.0;
	TInlet_Spread_Min		:= 99999.9;
	TInlet_Spread 		:= 0.0;
	TInlet_Avg_Nb_Of_Probe	:= 0.0;

	CASE 	ANY_TO_DINT ( T_INLET_PROBE_BINDING_SOURCE ) OF
		BINDING_DACN1_POWERDNA_IOMGR_T:
			
			FOR i:= 1 TO T_INLET_NUMBER_PROBE  BY 1 DO
				IF (DACN1_POWERDNA_IOMGR_T[ T_INLET_PROBE_INDEX[i] ].Out_Of_Service = FALSE ) THEN
					IF (DACN1_POWERDNA_IOMGR_T[ T_INLET_PROBE_INDEX[i] ].Mean_Value < 3000.0 And 
					    DACN1_POWERDNA_IOMGR_T[ T_INLET_PROBE_INDEX[i] ].Mean_Value > -460.0) THEN (* Validate if the reading is OK *)

						TInlet_Avg := TInlet_Avg  + (DACN1_POWERDNA_IOMGR_T[ T_INLET_PROBE_INDEX[i] ].Mean_Value);
						TInlet_Avg_Nb_Of_Probe := TInlet_Avg_Nb_Of_Probe + 1.0;

					END_IF;

					(* Record spread extremum *)
					IF(TInlet_Spread_Max < DACN1_POWERDNA_IOMGR_T[ T_INLET_PROBE_INDEX[i] ].Mean_Value) THEN
						TInlet_Spread_Max := DACN1_POWERDNA_IOMGR_T[ T_INLET_PROBE_INDEX[i] ].Mean_Value;
					END_IF;

					IF(TInlet_Spread_Min > DACN1_POWERDNA_IOMGR_T[ T_INLET_PROBE_INDEX[i] ].Mean_Value) THEN
						TInlet_Spread_Min := DACN1_POWERDNA_IOMGR_T[ T_INLET_PROBE_INDEX[i] ].Mean_Value;
					END_IF;

				END_IF;
			END_FOR;

	ELSE
		err_code := -4;
		dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PW210: T_INLET_PROBE_BINDING_SOURCE NOT SUPPORTED');
		RETURN;
	
	END_CASE;         
	IF (TInlet_Avg_Nb_Of_Probe > 0.0 ) THEN
		TInlet_Avg	:= TInlet_Avg / TInlet_Avg_Nb_Of_Probe;
	END_IF;

	TInlet_Spread := TInlet_Spread_Max - TInlet_Spread_Min;

	(* T EXHAUST *)

	TEgt_Avg 			:= 0.0;
	TEgt_Spread_Max		:= 0.0;
	TEgt_Spread_Min		:= 99999.9;
	TEgt_Spread 		:= 0.0;
	TEgt_Avg_Nb_Of_Probe	:= 0.0;

	CASE 	ANY_TO_DINT ( T_EGT_PROBE_BINDING_SOURCE ) OF
		BINDING_DACN1_POWERDNA_IOMGR_T:
			
			FOR i:= 1 TO T_EGT_NUMBER_PROBE  BY 1 DO

				(* Prode is not out of service *)
				IF (DACN1_POWERDNA_IOMGR_T[ T_EGT_PROBE_INDEX[i] ].Out_Of_Service = FALSE ) THEN

					(* Validate if the reading is OK for Avg *)
					IF (DACN1_POWERDNA_IOMGR_T[ T_EGT_PROBE_INDEX[i] ].Mean_Value < 3000.0 And 
					    DACN1_POWERDNA_IOMGR_T[ T_EGT_PROBE_INDEX[i] ].Mean_Value > -460.0) THEN 
						TEgt_Avg := TEgt_Avg  + (DACN1_POWERDNA_IOMGR_T[ T_EGT_PROBE_INDEX[i] ].Mean_Value);
						TEgt_Avg_Nb_Of_Probe := TEgt_Avg_Nb_Of_Probe + 1.0;
					END_IF;

					(* Record spread extremum *)
					IF(TEgt_Spread_Max < DACN1_POWERDNA_IOMGR_T[ T_EGT_PROBE_INDEX[i] ].Mean_Value) THEN
						TEgt_Spread_Max := DACN1_POWERDNA_IOMGR_T[ T_EGT_PROBE_INDEX[i] ].Mean_Value;
					END_IF;

					IF(TEgt_Spread_Min > DACN1_POWERDNA_IOMGR_T[ T_EGT_PROBE_INDEX[i] ].Mean_Value) THEN
						TEgt_Spread_Min := DACN1_POWERDNA_IOMGR_T[ T_EGT_PROBE_INDEX[i] ].Mean_Value;
					END_IF;

				END_IF;
			END_FOR;

		BINDING_DACN1_NIDAQ_IOMGR_VIN:
			
			FOR i:= 1 TO T_EGT_NUMBER_PROBE  BY 1 DO

				(* Prode is not out of service *)
				IF (DACN1_NIDAQ_IOMGR_VIN[ T_EGT_PROBE_INDEX[i] ].Out_Of_Service = FALSE ) THEN

					(* Validate if the reading is OK for Avg *)
					IF (DACN1_NIDAQ_IOMGR_VIN[ T_EGT_PROBE_INDEX[i] ].Mean_Value < 3000.0 And 
					    DACN1_NIDAQ_IOMGR_VIN[ T_EGT_PROBE_INDEX[i] ].Mean_Value > -460.0) THEN
						TEgt_Avg := TEgt_Avg  + (DACN1_NIDAQ_IOMGR_VIN[ T_EGT_PROBE_INDEX[i] ].Mean_Value);
						TEgt_Avg_Nb_Of_Probe := TEgt_Avg_Nb_Of_Probe + 1.0;
					END_IF;

					(* Record spread extremum *)
					IF(TEgt_Spread_Max < DACN1_NIDAQ_IOMGR_VIN[ T_EGT_PROBE_INDEX[i] ].Mean_Value) THEN
						TEgt_Spread_Max := DACN1_NIDAQ_IOMGR_VIN[ T_EGT_PROBE_INDEX[i] ].Mean_Value;
					END_IF;

					IF(TEgt_Spread_Min > DACN1_NIDAQ_IOMGR_VIN[ T_EGT_PROBE_INDEX[i] ].Mean_Value) THEN
						TEgt_Spread_Min := DACN1_NIDAQ_IOMGR_VIN[ T_EGT_PROBE_INDEX[i] ].Mean_Value;
					END_IF;

				END_IF;
			END_FOR;

	ELSE
		err_code := -7;
		dummy    := LOG_MSG('ErrLog', 'DACN1_UUT_CTRL_PW200: T_EGT_PROBE_BINDING_SOURCE NOT SUPPORTED');
		RETURN;
	
	END_CASE; 

	IF (TEgt_Avg_Nb_Of_Probe > 0.0 ) THEN
		TEgt_Avg	:= TEgt_Avg / TEgt_Avg_Nb_Of_Probe;
	END_IF;

	TEgt_Spread := TEgt_Spread_Max - TEgt_Spread_Min;


	(* Limits are based if ENGINE is in start / steady state : monitoring if engine has reached a speed equal or higher than Ground Idle (GI)*)

	IF (UUT_Info.Model = 'PW210A') THEN

		SPEED_AT_GI		:=	NPT_SPEED_AT_GI;
		REF_SPEED_RPM 	:=	NPT_Speed_RPM;

	ELSIF (UUT_Info.Model = 'PW210S') THEN

		SPEED_AT_GI		:=	NG_SPEED_AT_GI;
		REF_SPEED_RPM	:=	NG_Speed_RPM;

	ELSE
		SPEED_AT_GI		:=	0.0;
		REF_SPEED_RPM	:=	0.0;

	END_IF;


	(* Case we don't feed the variables correctly by OPC by HMI channels *)

	IF SPEED_AT_GI = 0.0 THEN           
	
		UUT_Trip_T[1].Trip_Point          := 0.0;
	
	ELSE

		IF (REF_SPEED_RPM < SPEED_AT_GI)  And (TRIM_UNTRIMMED_BTN = FALSE) THEN

			UUT_Trip_T[1].Trip_Point	:=	MGT_TRIP_START_UNTRIMMED;

		ELSIF (REF_SPEED_RPM < SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = TRUE) THEN

			UUT_Trip_T[1].Trip_Point	:=	MGT_TRIP_START_TRIMMED;

		ELSIF	(REF_SPEED_RPM >= SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = FALSE) THEN

			UUT_Trip_T[1].Trip_Point	:=	MGT_TRIP_SS_UNTRIMMED;

		ELSIF	(REF_SPEED_RPM >= SPEED_AT_GI) And (TRIM_UNTRIMMED_BTN = TRUE) THEN

			UUT_Trip_T[1].Trip_Point	:=	MGT_TRIP_SS_TRIMMED;

		END_IF;

	END_IF;


	UUT_Trip_T[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.T2;
	UUT_Trip_T[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.T3;
	UUT_Trip_T[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.T4;

	UUT_Trip_F[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.F1;
	UUT_Trip_F[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.F2;
	UUT_Trip_F[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.F3;
	UUT_Trip_F[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.F4;

	UUT_Trip_N[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.N1;
	UUT_Trip_N[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.N2;
	UUT_Trip_N[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.N3;
	UUT_Trip_N[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.N4;

	UUT_Trip_P[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.P1;
	UUT_Trip_P[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.P2;
	UUT_Trip_P[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.P3;
	UUT_Trip_P[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.P4;

	UUT_Trip_Q[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q1;
	UUT_Trip_Q[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q2;
	UUT_Trip_Q[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q3;
	UUT_Trip_Q[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.Q4;

	UUT_Trip_V[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.V1;
	UUT_Trip_V[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.V2;
	UUT_Trip_V[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.V3;
	UUT_Trip_V[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.V4;

	UUT_Trip_VIB[1].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB1;
	UUT_Trip_VIB[2].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB2;
	UUT_Trip_VIB[3].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB3;
	UUT_Trip_VIB[4].Trip_Point	:=	UUT_Info.UUT_TripPoints.VIB4;


	UUT_Trip_T[1].Trip_Source	:=	TExhaust;
(*	UUT_Trip_T[2].Trip_Source	:=	;*)
(*	UUT_Trip_T[3].Trip_Source	:=	;*)
(*	UUT_Trip_T[4].Trip_Source	:=	;*)


(*	UUT_Trip_F[1].Trip_Source	:=	;*)
(*	UUT_Trip_F[2].Trip_Source	:=	;*)
(*	UUT_Trip_F[3].Trip_Source	:=	;*)
(*	UUT_Trip_F[4].Trip_Source	:=	;*)

	UUT_Trip_N[1].Trip_Source	:=	NG_Speed_RPM;
	UUT_Trip_N[2].Trip_Source	:=	NPT_Speed_RPM;
(*	UUT_Trip_N[3].Trip_Source	:=	;*)
(*	UUT_Trip_N[4].Trip_Source	:=	;*)

(*	UUT_Trip_P[1].Trip_Source	:=	;*)
(*	UUT_Trip_P[2].Trip_Source	:=	;*)
(*	UUT_Trip_P[3].Trip_Source	:=	;*)
(*	UUT_Trip_P[4].Trip_Source	:=	;*)

	UUT_Trip_Q[1].Trip_Source	:=	Torque_Source;
(*	UUT_Trip_Q[2].Trip_Source	:=	;*)
(*	UUT_Trip_Q[3].Trip_Source	:=	;*)
(*	UUT_Trip_Q[4].Trip_Source	:=	;*)

(*	UUT_Trip_V[1].Trip_Source	:=	;*)
(*	UUT_Trip_V[2].Trip_Source	:=	;*)
(*	UUT_Trip_V[3].Trip_Source	:=	;*)
(*	UUT_Trip_V[4].Trip_Source	:=	;*)

(*	UUT_Trip_VIB[1].Trip_Source	:=	;*)
(*	UUT_Trip_VIB[2].Trip_Source	:=	;*)
(*	UUT_Trip_VIB[3].Trip_Source	:=	;*)
(*	UUT_Trip_VIB[4].Trip_Source	:=	;*)


EGT_Limit := UUT_Trip_T[1].Trip_Point;



























END_FUNCTION_BLOCK
