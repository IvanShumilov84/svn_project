FUNCTION_BLOCK open_UUT_Ctrl_PT6A_FB
(************************************************************************************************************************************************
	Name :		open_UUT_Ctrl_PT6A._FB									
														
	Description :	Code for importing Speed,INLET, EGT and InterTurbine static Data to the Workbench at Opening.
    

	Dependacy : 	

					HISTORY
	Rev			Date			Name			Description
		     		(YYYY/MM/DD)

	1.0	         	2015/09/ 		?.....		First Release
	2.0	         	2015/09/23		A. Armand		Added :  Engine Model handling, and Probes number for Project 14086
	2.1			2015/11/13		A.Armand		Added : TT4 TRIP for PT6A-6 Engines
	
************************************************************************************************************************************************)	


		
		(* Parameters are retrieved from XML(.cfg) file by engine model *)
		Prefix_String := 'ConfigurationSettings.' + UUT_INFO.Model + '.';


		(* SPEED *)
		(* NGT values are the same, but INDEX are different in the config file of this project*)
		NG_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'NG_INDEX', '0');
		NG_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'NG_BINDING_SOURCE', '0'));
		NG_100_RPM 				:= ReadOneRealConfigItemST( Prefix_String + 'NG_100_RPM_CONSTANT', '0');
		NG_100_FREQ 			:= ReadOneRealConfigItemST( Prefix_String + 'NG_100_FREQ_CONSTANT', '0');

		NF_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'NF_INDEX', '0');
		NF_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'NF_BINDING_SOURCE', '0'));
		NF_100_RPM 				:= ReadOneRealConfigItemST( Prefix_String + 'NF_100_RPM_CONSTANT', '0');
		NF_100_FREQ 			:= ReadOneRealConfigItemST( Prefix_String + 'NF_100_FREQ_CONSTANT', '0');

		TORQUE_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'TORQUE_INDEX', '0');
		TORQUE_BINDING_SOURCE 		:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'TORQUE_BINDING_SOURCE', '0'));

		(* T_INLET  *)
		T_T1_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T1_PROBE_BINDING_SOURCE', '0'));
		T_T1_NUMBER_PROBE 		:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T1_NUMBER_PROBE', '0');

		FOR i:=1 TO T_T1_NUMBER_PROBE BY 1 DO
			
			T_T1_PROBE_INDEX[i] 	:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T1_PROBE_INDEX' + ANY_TO_STRING(i), '0');

		END_FOR;

			
		(* T_EGT *)
		T_T7_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T7_PROBE_BINDING_SOURCE', '0'));
		T_T7_NUMBER_PROBE   		:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T7_NUMBER_PROBE', '0');

		FOR i:=1 TO T_T7_NUMBER_PROBE BY 1 DO
			
			T_T7_PROBE_INDEX[i] 	:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T7_PROBE_INDEX' + ANY_TO_STRING(i), '0');

		END_FOR;

		
		(* ITT  *)
		(* PT6A- 6 are using TT4 instead of TT5 *)

		IF ((UUT_Info.Model = 'PT6A-6') OR (UUT_Info.Model = 'PT6A-6A') OR (UUT_Info.Model = 'PT6A-6B')) THEN

			T_T4_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T4_PROBE_BINDING_SOURCE', '0'));
			T_T4_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T4_INDEX', '0');

			T4_TRIP_START_TRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T4_TRIP_START_TRIMMED', '0');
			T4_TRIP_START_UNTRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T4_TRIP_START_UNTRIMMED', '0');
			T4_TRIP_SS_TRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T4_TRIP_SS_TRIMMED', '0');
			T4_TRIP_SS_UNTRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T4_TRIP_SS_UNTRIMMED', '0');
		ELSE
			
			T_T5_PROBE_BINDING_SOURCE 	:= ConvertBindingSourceStringToDint(ReadOneStringConfigItemST( Prefix_String + 'T_T5_PROBE_BINDING_SOURCE', '0'));
			T_T5_INDEX 				:= ReadOneIntegerConfigItemST( Prefix_String + 'T_T5_INDEX', '0');

			T5_TRIP_START_TRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_START_TRIMMED', '0');
			T5_TRIP_START_UNTRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_START_UNTRIMMED', '0');
			T5_TRIP_SS_TRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_SS_TRIMMED', '0');
			T5_TRIP_SS_UNTRIMMED		:= ReadOneRealConfigItemST( Prefix_String + 'T5_TRIP_SS_UNTRIMMED', '0');

		END_IF;



















END_FUNCTION_BLOCK