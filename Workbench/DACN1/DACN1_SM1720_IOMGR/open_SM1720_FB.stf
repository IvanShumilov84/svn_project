	FCU_throttle_info.Idle_Point.Enabled 				:= TRUE;
	FCU_throttle_info.Idle_Point.Capture_required 		:= TRUE;
	FCU_throttle_info.Idle_Point.Capture_done 			:= FALSE;

	FCU_throttle_info.Max_Stop_Point.Enabled 			:= TRUE;
	FCU_throttle_info.Max_Stop_Point.Capture_required 	:= TRUE;
	FCU_throttle_info.Max_Stop_Point.Capture_done 		:= FALSE;
		


	(* Used for Flight Simulator Mode on Texcel V100 *)

	FCU_flightsim_required 	:=	TRUE; (* flight simulator for TEXCEL v100 is active *)

	FCU_throttle_info.FlightSim_Min_Point.Enabled 			:= FCU_flightsim_required;
	FCU_throttle_info.FlightSim_Min_Point.Capture_required 	:= FCU_flightsim_required;
	FCU_throttle_info.FlightSim_Min_Point.Capture_done 		:= FALSE;
	FCU_throttle_info.FlightSim_Min_Point.Position_degree	:= 0.0; (* 0 deg = 0 vdc *)
	FCU_throttle_info.Vout_Min_Point.Enabled 				:= FALSE;
	FCU_throttle_info.Vout_Min_Point.Capture_required 		:= FALSE;
	FCU_throttle_info.Vout_Min_Point.Position_degree		:= FCU_throttle_info.FlightSim_Min_Point.Position_degree;
	FCU_throttle_info.Vout_Min_Point.Position_vdc			:= 0.0; (* 0 deg = 0 vdc *)

	FCU_throttle_info.FlightSim_Max_Point.Enabled 			:= FCU_flightsim_required;
	FCU_throttle_info.FlightSim_Max_Point.Capture_required 	:= FCU_flightsim_required;
	FCU_throttle_info.FlightSim_Max_Point.Capture_done 		:= FALSE;
	FCU_throttle_info.FlightSim_Max_Point.Position_degree	:= 90.0; (* 90 deg = 9 vdc *)
	FCU_throttle_info.Vout_Max_Point.Enabled 				:= TRUE;
	FCU_throttle_info.Vout_Max_Point.Capture_required 		:= FALSE;
	FCU_throttle_info.Vout_Max_Point.Position_degree		:= FCU_throttle_info.FlightSim_Max_Point.Position_degree; 
	FCU_throttle_info.Vout_Max_Point.Position_vdc			:= 9.0;  (* 90 deg = 9 vdc *)

ELSE

	(* Nothing to do for DAS Calibration *)

	FCU_required := FALSE;

	GOV_required := FALSE;

END_IF; 

status := OPENED;













END_FUNCTION_BLOCK
