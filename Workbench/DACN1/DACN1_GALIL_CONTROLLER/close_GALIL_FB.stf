FUNCTION_BLOCK close_GALIL_FB
(************************************************************************************************************************************************
	Name :		close_GALIL_FB									
														
	Description :	Close all ethernet port to GALIL drive

	Dependacy : 	
					HYSTORY

	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         				First Release

************************************************************************************************************************************************)	
	status 	:= CLOSING;
	err_code 	:= OK;

	(* Log message every 15 minutes. 900 000 ms *)
	IF  (mod_rest = 0) THEN
		dummy 		:= LOG_MSG('ErrLog', 'DACN1_GALIL_CONTROLLER: CLOSING');
	END_IF;

	mod_rest := MOD( ( __SYSVA_CYCLECNT * ANY_TO_DINT(__SYSVA_TCYCYCTIME) ), 900000 ) ;



	IF First_Time_Close = TRUE THEN
		mod_rest := 0;

		IF ( UUT_Info.Model <> 'DAS CALIBRATION' ) THEN

			(* Stop Controller Galil en disconnect *)

			STOP_CONTROLLER_GALIL( ihdmc );
			err_code := STOP_CONTROLLER_GALIL.ERR_CODE;

			DISCONNECT_CONTROLLER_GALIL( ihdmc );
			err_code := DISCONNECT_CONTROLLER_GALIL.ERR_CODE;

			First_Time_Close := FALSE;
		END_IF;
	END_IF;



	IF (err_code = OK) THEN 
		status := CLOSED;
		dummy 		:= LOG_MSG('ErrLog', 'DACN1_GALIL_CONTROLLER: CLOSED');

		mod_rest := 0;

	END_IF; 








END_FUNCTION_BLOCK
