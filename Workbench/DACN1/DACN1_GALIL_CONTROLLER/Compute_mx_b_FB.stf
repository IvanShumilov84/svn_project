FUNCTION_BLOCK COMPUTE_MX_B_FB
(************************************************************************************************************************************************
	Name :		compute_mx_b_FB
														
	Description :	 							      

	Dependacy : 	
					HYSTORY

	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         					First Release

************************************************************************************************************************************************)	

	delta_x := x2 - x1;

	IF (delta_x <> 0.0) THEN 
		slope := (y2 - y1) / (x2 - x1);

		offset  := y1 - (slope * x1);
	END_IF; 

END_FUNCTION_BLOCK
