FUNCTION_BLOCK load_VX100_FB
status 		:= LOADING;
err_code 	:= OK;


IF (First_Time_Set = TRUE) THEN

	IF(In_Texcel_VX100_IOMgr.mode = RUN_FOR_TRUE )THEN

		CASE (load_step) OF
		0:
			REQUEST_VX100_MODEL_TEXT_STRINGS(fd);

			err_code := REQUEST_VX100_MODEL_TEXT_STRINGS.ERR_CODE;
			load_step := load_step + 1;
		1:
			READ_VX100_MODEL_TEXT_STRINGS(fd);
	
			IF (READ_VX100_MODEL_TEXT_STRINGS.ERR_CODE = 0) THEN
				VX100_MODEL_STRINGS := READ_VX100_MODEL_TEXT_STRINGS.modelTextStrings;
				err_code := OK;
			ELSE
				err_code := -1;
			END_IF;
			load_step := load_step + 1;
		2:
			SET_VX100_CHANNELS(fd, num_of_channels, channel_no);

			IF SET_VX100_CHANNELS.ERR_CODE = -1 THEN
				Error_on_Open := TRUE ;
			ELSE
				CASE (SET_VX100_CHANNELS.RESP_CODE) OF
				1:
					err_code := OK;
				3:
					dummy := LOG_MSG('ErrLog', 'DACN1_TEXEL_VX100_IOMGR : SET_VX100_CHANNELS command rejected, Invalid channel?');
					err_code := -1;
				ELSE
					dummy := LOG_MSG('ErrLog', 'DACN1_TEXEL_VX100_IOMGR : SET_VX100_CHANNELS unexpected response code!!');
				END_CASE;
			END_IF ;
	
			load_step := load_step + 1;
		3:
			First_Time_Set := FALSE ;

		END_CASE;
	ELSE

		First_Time_Set := FALSE ;

	END_IF;

END_IF;
	
IF ((err_code <> OK) OR (First_Time_Set = FALSE)) THEN

	IF (err_code <> OK) THEN 

		status	:= ERROR_ON_LOADING;
		dummy 	:= LOG_MSG('ErrLog', 'DACN1_TEXCEL_VX100_IOMGR: ERROR ON LOADING');

	ELSE

		status	:= LOADED;
		dummy		:= LOG_MSG('ErrLog', 'DACN1_TEXCEL_VX100_IOMGR: LOADED');

	END_IF; 

	load_step := 0;

END_IF;

















































END_FUNCTION_BLOCK
