FUNCTION_BLOCK initialize_Scanivalve_FB
(************************************************************************************************************************************************
	Name :		initialize_Scanivalve_IOMgr_FB									
														
	Description :	One shot initialization prior to run 							      

	Dependacy : 	
					HYSTORY

	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         2001/05/12		M.Morisset	First Release
	3.0	         2004/12/07		N. Sangiovanni	Adapt for CELDAS200 Generation
	3.1		 2005/03/01		D. Lepage	Close REAL_DATA as soon as we are finished with it

************************************************************************************************************************************************)	

	status 		:= INITIALIZING;
	dummy		:= LOG_MSG('ErrLog', 'DACN1_SCANIVALVE_PRESSURE_IOMGR: INITIALIZING');
	err_code 	:= OK;


	(* Initialise Scanivalve *)
	FOR i := 1 TO Number_of_Scanivalve DO

		IF In_Scanivalve_Pressure_IOMgr.mode = RUN_FOR_TRUE THEN

			SCANIVALVE_INIT(ScaniValve_Structure[i].Sock, Scanivalve_Structure[i].Model, Scanivalve_Structure[i].Eng_Unit);

			ScaniValve_Structure[i].err_code 	:= SCANIVALVE_INIT.ERR_CODE;

		END_IF;

		IF (ScaniValve_Structure[i].err_code <> OK) THEN
			ScaniValve_Structure[i].Sock 	:= -1;
			i 				:= Number_of_Scanivalve ;
			err_code 			:= ScaniValve_Structure[i].err_code;
		END_IF;
	END_FOR;


	IF err_code = OK THEN
	(* Open CSV of Scanivalve *)
		OPEN_REAL_DATA( ScaniValve_Structure[1].Filename ) ;
		hdle_real_data	:= OPEN_REAL_DATA.handle ;
		err_code 	:= OPEN_REAL_DATA.errcode;

		IF (err_code = OK) THEN
	(* Real File Reading *)
			READ_REAL_DATA ( hdle_real_data ) ;

			WHILE READ_REAL_DATA.errcode = 103 DO 

				FV_EXTRACT(READ_REAL_DATA.name);

				IF (READ_REAL_DATA.deviceid <> 'SPARE' AND FV_EXTRACT.FV_TYPE = FV_P) THEN 
					
					current_FV 		:= current_FV + 1;

					FV[current_FV].FV_type 	:= FV_EXTRACT.FV_TYPE;
					FV[current_FV].FV_index := FV_EXTRACT.FV_INDEX;
					FV[current_FV].channel 	:= READ_REAL_DATA.channel;

					FOR i := 1 TO Number_of_Scanivalve DO
						IF READ_REAL_DATA.deviceid = ScaniValve_Structure[i].IPAddress THEN
							FV[current_FV].level_handle := ScaniValve_Structure[i].IPAddress;
							EXIT;
						END_IF;
					END_FOR;
		
					err_code := FV_EXTRACT.ERR_CODE;

					IF err_code = OK THEN	
						st_rdata_user := READ_REAL_DATA.st_record ;
						INIT_RDATA(rdata_base, st_rdata_user) ;
						FV[current_FV].data_handle := INIT_RDATA.data_handle ;
						err_code := INIT_RDATA.ERR_CODE ;
					END_IF;
				END_IF; 

				READ_REAL_DATA ( hdle_real_data ) ;
	
			END_WHILE;

			CLOSE_REAL_DATA(hdle_real_data);
		END_IF;

		number_of_var := current_FV;
	END_IF;

		
	IF (err_code <> OK) THEN 
		status 	:= ERROR_ON_INITIALIZING;
		dummy	:= LOG_MSG('ErrLog', 'DACN1_SCANIVALVE_PRESSURE_IOMGR: ERROR ON INITIALIZING');
	ELSE 
		IF (current_FV > 0 OR In_Scanivalve_Pressure_IOMgr.mode <> RUN_FOR_TRUE ) THEN  
			status 		:= INITIALIZED;
			dummy		:= LOG_MSG('ErrLog', 'DACN1_SCANIVALVE_PRESSURE_IOMGR: INITIALIZED');
			current_FV 	:= 0 ;
		END_IF; 
	END_IF; 

	(* Scanning one Scanivalve per cycle instead of scanning all scanivalves per cycle *)
	i := 1;













END_FUNCTION_BLOCK
