FUNCTION ReadOneIntegerConfigItemST
(************************************************************************************************************************************************

	Function ReadOneIntegerConfigItem									
														
************************************************************************************************************************************************)	


	XMLCFGSETTINGS_GETSTRINGVALUE(hCfgSettings, ItemName, DefaultValue);

	ReadOneIntegerConfigItemST := ANY_TO_DINT(XMLCFGSETTINGS_GETSTRINGVALUE.VALUE);

	IF XMLCFGSETTINGS_GETSTRINGVALUE.ERR_CODE <> 0 THEN

		XMLError := True;
		dummy := LOG_MSG('ErrLog', 'DACN1_USER_INTERFACE:ERROR:' + ItemName);

	END_IF;




END_FUNCTION
