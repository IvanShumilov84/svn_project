FUNCTION_BLOCK LOAD_USER_INTERFACE_FB
(************************************************************************************************************************************************
	Name :		load_User_Interface_FB									
														
	Description :	   

	Dependacy : 	

					HYSTORY
	Rev		Date		Name		Description
		        (YYYY/MM/DD)

	1.0	         					First Release

************************************************************************************************************************************************)	

	status 		:= LOADING;
	dummy		:= LOG_MSG('ErrLog', 'DACN1_USER_INTERFACE: LOADING');
	err_code 	:= OK;

	IF (err_code <> OK) THEN 
		status 	:= ERROR_ON_LOADING;
		dummy	:= LOG_MSG('ErrLog', 'DACN1_USER_INTERFACE: ERROR ON LOADING');
	ELSE 
		status 	:= LOADED;
		dummy	:= LOG_MSG('ErrLog', 'DACN1_USER_INTERFACE: LOADED');
	END_IF; 	

END_FUNCTION_BLOCK
